[{"i": 0, "text": "Day five of building the first TikTok cat town.", "dur": 2.472}, {"i": 1, "text": "Mister Fireman said: a giant slice of pizza... with every single topping!", "dur": 4.096}, {"i": 2, "text": "Every. Single. Topping. Okay... let's go!", "dur": 2.356}, {"i": 3, "text": "Crust!", "dur": 0.421}, {"i": 4, "text": "Sauce!", "dur": 0.426}, {"i": 5, "text": "Cheese!", "dur": 0.472}, {"i": 6, "text": "Pepperoni!", "dur": 0.587}, {"i": 7, "text": "Mushrooms!", "dur": 0.619}, {"i": 8, "text": "Olives!", "dur": 0.501}, {"i": 9, "text": "Peppers!", "dur": 0.479}, {"i": 10, "text": "Onions!", "dur": 0.492}, {"i": 11, "text": "Corn!", "dur": 0.406}, {"i": 12, "text": "Bacon!", "dur": 0.477}, {"i": 13, "text": "Everything!", "dur": 0.501}, {"i": 14, "text": "And... pineapple.", "dur": 0.877}, {"i": 15, "text": "He said every topping.", "dur": 1.103}, {"i": 16, "text": "And a fish. It is a cat town.", "dur": 1.442}, {"i": 17, "text": "The giant pizza is done. Mango, how is it?", "dur": 2.429}, {"i": 18, "text": "Meow!", "dur": 0.404}, {"i": 19, "text": "Comment your idea. The top comment gets built tomorrow!", "dur": 2.847}]