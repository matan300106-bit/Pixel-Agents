    "pm2_extras": {
      "type": "petme2-product-extras",
      "settings": {
        "feeder_features": "Scheduled meals :: Set feeding times and portions in the app\nStainless steel bowls :: Food-safe steel that washes easily\nAnti-jam design :: Helps kibble flow smoothly\nEasy to clean :: Bowls and food container come apart",
        "fountain_features": "Quiet pump :: Calm enough for any room\nVisible water level :: See when it is time to refill\nEasy to take apart :: Simple weekly cleaning\nFor cats & dogs :: Fresh flowing water every day",
        "dq1": "Can I use wet food?",
        "da1": "No. PETME2 feeders are made for dry food (kibble).",
        "dq2": "Can it feed two pets?",
        "da2": "Yes, the 3L Dual Bowl and the 5L Elevated feeders split food into two bowls. The 3L Camera Feeder has one bowl.",
        "dq3": "Do I need WiFi?",
        "da3": "WiFi is needed for the app: schedules, portions and alerts. Setup steps are in the manual.",
        "dq4": "How do I clean it?",
        "da4": "Take off the bowls and the food container and wash them. The manual shows which parts are dishwasher safe.",
        "dq5": "Is PETME2 also on Amazon?",
        "da5": "Yes. PETME2 feeders are also sold on Amazon, where you can read buyer reviews.",
        "fq1": "Is the pump loud?",
        "fa1": "No. Every PETME2 fountain uses a quiet pump made for use inside the home.",
        "fq2": "How often should I clean it?",
        "fa2": "We suggest a quick clean once a week: take it apart, rinse, and put it back together.",
        "fq3": "Does it have a filter?",
        "fa3": "The Stainless 3.2L and the Steel Tray 2.2L have a 4-layer filter. The Transparent 2.2L has a filter cartridge. Details are in the manual.",
        "fq4": "Is it good for dogs too?",
        "fa4": "Yes. PETME2 fountains work for cats and dogs. For bigger dogs, the Stainless 3.2L holds the most water.",
        "fq5": "Is PETME2 also on Amazon?",
        "fa5": "Yes. PETME2 fountains are also sold on Amazon, where you can read buyer reviews.",
        "pair_eyebrow": "Complete the setup",
        "pair_button": "View",
        "pair_for_feeder": "water-fountain",
        "pair_for_fountain": "2-in-1-smart-feeder"
      }
    },
