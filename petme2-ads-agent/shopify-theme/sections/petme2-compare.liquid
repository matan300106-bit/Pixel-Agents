{%- comment -%} PETME2 comparison chart. One block = one model. Price, image and link come live from the product. {%- endcomment -%}
{%- assign labels = section.settings.row1 | append: '|' | append: section.settings.row2 | append: '|' | append: section.settings.row3 | append: '|' | append: section.settings.row4 | append: '|' | append: section.settings.row5 | split: '|' -%}
<section class="pm2-cmp" id="{{ section.settings.anchor | default: section.id }}" style="--pm2-bg: {{ section.settings.bg }};">
  <div class="pm2-cmp__inner">
    <div class="pm2-cmp__head">
      {%- if section.settings.eyebrow != blank -%}<p class="pm2-cmp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="pm2-cmp__sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="pm2-cmp__scroll">
      <table class="pm2-cmp__table">
        <thead>
          <tr>
            <th scope="col" class="pm2-cmp__corner"></th>
            {%- for block in section.blocks -%}
              {%- assign p = block.settings.product -%}
              <th scope="col" {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}<span class="pm2-cmp__badge">{{ block.settings.badge }}</span>{%- endif -%}
                {%- if p != blank and p.featured_image -%}
                  <a href="{{ p.url }}" class="pm2-cmp__img">{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}</a>
                {%- endif -%}
                <a href="{{ p.url | default: '#' }}" class="pm2-cmp__name">{{ block.settings.name }}</a>
                {%- if p != blank -%}<span class="pm2-cmp__price">{{ p.price | money }}</span>{%- endif -%}
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for label in labels -%}
            {%- if label == blank -%}{%- continue -%}{%- endif -%}
            {%- assign key = 'v' | append: forloop.index -%}
            <tr>
              <th scope="row">{{ label }}</th>
              {%- for block in section.blocks -%}<td>{{ block.settings[key] | default: '—' }}</td>{%- endfor -%}
            </tr>
          {%- endfor -%}
          <tr class="pm2-cmp__cta">
            <th scope="row"></th>
            {%- for block in section.blocks -%}
              <td>{%- if block.settings.product != blank -%}<a class="pm2-btn" href="{{ block.settings.product.url }}">{{ section.settings.button_text }}</a>{%- endif -%}</td>
            {%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .pm2-cmp { background: var(--pm2-bg); color: #111; padding: 96px 0; }
  .pm2-cmp__inner { max-width: 1240px; margin: 0 auto; padding: 0 20px; }
  .pm2-cmp__head { text-align: center; max-width: 640px; margin: 0 auto 44px; }
  .pm2-cmp__eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: 12px; opacity: .6; margin: 0 0 10px; }
  .pm2-cmp__head h2 { font-size: clamp(28px, 3.4vw, 40px); font-weight: 400; letter-spacing: -.01em; margin: 0 0 12px; }
  .pm2-cmp__sub { opacity: .7; margin: 0; font-size: 15px; line-height: 1.6; }
  .pm2-cmp__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pm2-cmp__table { width: 100%; border-collapse: collapse; min-width: 640px; background: #fff; }
  .pm2-cmp__table th, .pm2-cmp__table td { padding: 16px 18px; text-align: center; border-bottom: 1px solid #e9e7e3; font-size: 14px; line-height: 1.45; vertical-align: middle; }
  .pm2-cmp__table tbody th { text-align: left; font-weight: 500; white-space: nowrap; position: sticky; left: 0; background: #fff; z-index: 1; }
  .pm2-cmp__table thead th { vertical-align: top; font-weight: 400; padding-top: 26px; position: relative; }
  .pm2-cmp__corner { position: sticky; left: 0; background: #fff; z-index: 1; }
  .pm2-cmp__img { display: block; aspect-ratio: 1; margin: 0 auto 12px; max-width: 150px; background: #f6f5f3; }
  .pm2-cmp__img img { width: 100%; height: 100%; object-fit: contain; }
  .pm2-cmp__name { display: block; color: #111; text-decoration: none; font-weight: 500; font-size: 15px; }
  .pm2-cmp__price { display: block; margin-top: 4px; opacity: .7; }
  .pm2-cmp__badge { position: absolute; top: 6px; left: 50%; transform: translateX(-50%); background: #111; color: #fff; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; padding: 3px 8px; white-space: nowrap; }
  .pm2-cmp__cta td { border-bottom: 0; padding-top: 22px; }
  .pm2-btn { display: inline-block; background: #111; color: #fff; text-decoration: none; padding: 11px 22px; font-size: 13px; letter-spacing: .04em; transition: opacity .2s; }
  .pm2-btn:hover { opacity: .8; }
  @media (max-width: 749px) { .pm2-cmp { padding: 60px 0; } .pm2-cmp__table th, .pm2-cmp__table td { padding: 12px 10px; font-size: 13px; } }
</style>

{% schema %}
{
  "name": "PETME2 comparison",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id (for #links)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare models" },
    { "type": "text", "id": "text", "label": "Sub text" },
    { "type": "text", "id": "row1", "label": "Row 1 label", "default": "Capacity" },
    { "type": "text", "id": "row2", "label": "Row 2 label" },
    { "type": "text", "id": "row3", "label": "Row 3 label" },
    { "type": "text", "id": "row4", "label": "Row 4 label" },
    { "type": "text", "id": "row5", "label": "Row 5 label" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "View details" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f6f5f3" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Model",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "name", "label": "Short name" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "text", "id": "v1", "label": "Row 1 value" },
        { "type": "text", "id": "v2", "label": "Row 2 value" },
        { "type": "text", "id": "v3", "label": "Row 3 value" },
        { "type": "text", "id": "v4", "label": "Row 4 value" },
        { "type": "text", "id": "v5", "label": "Row 5 value" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "PETME2 comparison" }]
}
{% endschema %}
