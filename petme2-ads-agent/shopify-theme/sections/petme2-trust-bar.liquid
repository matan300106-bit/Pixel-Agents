{%- comment -%} PETME2 trust bar: short, true promises under the hero. Premium minimal style. {%- endcomment -%}
<div class="pm2-trust" style="--pm2-bg: {{ section.settings.bg }}; --pm2-fg: {{ section.settings.fg }};">
  <div class="pm2-trust__inner">
    {%- for block in section.blocks -%}
      <div class="pm2-trust__item" {{ block.shopify_attributes }}>
        <span class="pm2-trust__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
            {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
            {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5h16v11H9l-5 4z"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z"/></svg>
          {%- endcase -%}
        </span>
        <span>
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .pm2-trust { background: var(--pm2-bg); color: var(--pm2-fg); border-top: 1px solid rgba(0,0,0,.06); border-bottom: 1px solid rgba(0,0,0,.06); }
  .pm2-trust__inner { max-width: 1240px; margin: 0 auto; padding: 22px 20px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .pm2-trust__item { display: flex; align-items: center; gap: 12px; font-size: 14px; line-height: 1.35; }
  .pm2-trust__item strong { display: block; font-weight: 500; letter-spacing: .01em; }
  .pm2-trust__item small { display: block; opacity: .65; font-size: 12.5px; margin-top: 2px; }
  .pm2-trust__icon { width: 26px; height: 26px; flex: 0 0 26px; }
  .pm2-trust__icon svg { width: 100%; height: 100%; }
  @media (max-width: 899px) { .pm2-trust__inner { grid-template-columns: repeat(2, 1fr); padding: 18px 16px; gap: 16px; } }
</style>

{% schema %}
{
  "name": "PETME2 trust bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#f6f5f3" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "drop", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "lock", "label": "Lock" },
          { "value": "star", "label": "Star" }, { "value": "chat", "label": "Chat" }, { "value": "drop", "label": "Water drop" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Free U.S. shipping" },
        { "type": "text", "id": "text", "label": "Small text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "PETME2 trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
