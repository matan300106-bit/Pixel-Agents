{%- comment -%}
  PETME2 product extras: feature icons, what's in the box, FAQ, and a "complete the setup" pair.
  Feeder or fountain is chosen from product.type. "In the box" comes from metafield custom.in_the_box (one item per line).
{%- endcomment -%}
{%- assign is_fountain = false -%}
{%- assign t = product.type | downcase -%}
{%- if t contains 'fountain' or product.handle contains 'fountain' -%}{%- assign is_fountain = true -%}{%- endif -%}

{%- if is_fountain -%}
  {%- assign feats = section.settings.fountain_features | newline_to_br | split: '<br />' -%}
  {%- assign pair = section.settings.pair_for_fountain -%}
  {%- assign faq_prefix = 'f' -%}
{%- else -%}
  {%- assign feats = section.settings.feeder_features | newline_to_br | split: '<br />' -%}
  {%- assign pair = section.settings.pair_for_feeder -%}
  {%- assign faq_prefix = 'd' -%}
{%- endif -%}

<div class="color-{{ section.settings.color_scheme }} gradient pm2-px">
  <div class="page-width pm2-px__inner">
    <ul class="pm2-px__feats">
      {%- for f in feats -%}
        {%- assign parts = f | strip | split: '::' -%}
        {%- if parts[0] == blank -%}{%- continue -%}{%- endif -%}
        <li>
          <span class="pm2-px__dot" aria-hidden="true"></span>
          <strong>{{ parts[0] | strip }}</strong>
          {%- if parts[1] -%}<small>{{ parts[1] | strip }}</small>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="pm2-px__cols">
      {%- assign box = product.metafields.custom.in_the_box.value -%}
      {%- if box != blank -%}
        <div class="pm2-px__box">
          <h3>What's in the box</h3>
          <ul>
            {%- assign items = box | newline_to_br | split: '<br />' -%}
            {%- for i in items -%}{%- if i != blank -%}<li>{{ i | strip }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="pm2-px__faq">
        <h3>Questions</h3>
        {%- for n in (1..5) -%}
          {%- assign qk = faq_prefix | append: 'q' | append: n -%}
          {%- assign ak = faq_prefix | append: 'a' | append: n -%}
          {%- if section.settings[qk] != blank -%}
            <details>
              <summary>{{ section.settings[qk] }}</summary>
              <div>{{ section.settings[ak] }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if pair != blank and pair.id != product.id -%}
      <div class="pm2-px__pair">
        <a href="{{ pair.url }}" class="pm2-px__pairimg">{%- if pair.featured_image -%}{{ pair.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: pair.title }}{%- endif -%}</a>
        <div>
          <p class="pm2-px__eyebrow">{{ section.settings.pair_eyebrow }}</p>
          <a href="{{ pair.url }}" class="pm2-px__pairname">{{ pair.title }}</a>
          <p class="pm2-px__pairprice">{{ pair.price | money }}</p>
        </div>
        <a class="button" href="{{ pair.url }}">{{ section.settings.pair_button }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .pm2-px { padding: 80px 0; }
  .pm2-px__feats { list-style: none; margin: 0 0 56px; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .pm2-px__feats li { background: rgba(var(--color-foreground), .04); border: 1px solid rgba(var(--color-foreground), .1); border-radius: 16px; padding: 26px 22px; }
  .pm2-px__feats strong { display: block; font-weight: 600; font-size: 1.6rem; margin-top: 14px; color: rgb(var(--color-foreground)); }
  .pm2-px__feats small { display: block; color: rgba(var(--color-foreground), .65); font-size: 1.3rem; line-height: 1.5; margin-top: 4px; }
  .pm2-px__dot { display: block; width: 28px; height: 4px; background: rgb(var(--color-button)); border-radius: 4px; }
  .pm2-px__cols { display: grid; grid-template-columns: 1fr 1.6fr; gap: 56px; }
  .pm2-px__cols > :only-child { grid-column: 1 / -1; }
  .pm2-px__cols h3 { margin: 0 0 18px; }
  .pm2-px__box ul { margin: 0; padding: 0; list-style: none; }
  .pm2-px__box li { padding: 11px 0 11px 22px; border-bottom: 1px solid rgba(var(--color-foreground), .1); position: relative; }
  .pm2-px__box li::before { content: ''; position: absolute; left: 0; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: rgb(var(--color-button)); }
  .pm2-px__faq details { border-bottom: 1px solid rgba(var(--color-foreground), .1); }
  .pm2-px__faq summary { cursor: pointer; padding: 18px 32px 18px 0; list-style: none; position: relative; font-weight: 600; }
  .pm2-px__faq summary::-webkit-details-marker { display: none; }
  .pm2-px__faq summary::after { content: '+'; position: absolute; right: 4px; top: 12px; font-size: 2.2rem; font-weight: 300; color: rgb(var(--color-button)); }
  .pm2-px__faq details[open] summary::after { content: '\2013'; }
  .pm2-px__faq details div { padding: 0 0 20px; color: rgba(var(--color-foreground), .72); line-height: 1.6; }
  .pm2-px__pair { margin-top: 56px; display: grid; grid-template-columns: 110px 1fr auto; gap: 24px; align-items: center; border: 1px solid rgba(var(--color-foreground), .12); border-radius: 16px; padding: 20px 24px; }
  .pm2-px__pairimg { display: block; aspect-ratio: 1; background: #fff; border-radius: 12px; overflow: hidden; }
  .pm2-px__pairimg img { width: 100%; height: 100%; object-fit: contain; }
  .pm2-px__eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: 1.1rem; color: rgb(var(--color-button)); margin: 0 0 6px; font-weight: 600; }
  .pm2-px__pairname { color: rgb(var(--color-foreground)); text-decoration: none; font-weight: 600; }
  .pm2-px__pairprice { margin: 4px 0 0; color: rgba(var(--color-foreground), .7); }
  @media (max-width: 899px) {
    .pm2-px { padding: 56px 0; }
    .pm2-px__feats { grid-template-columns: repeat(2, 1fr); }
    .pm2-px__cols { grid-template-columns: 1fr; gap: 40px; }
    .pm2-px__pair { grid-template-columns: 80px 1fr; }
    .pm2-px__pair .button { grid-column: 1 / -1; }
  }
</style>

{% schema %}
{
  "name": "PETME2 product extras",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Feature icons (one per line: Title :: small text)" },
    { "type": "textarea", "id": "feeder_features", "label": "Feeder features" },
    { "type": "textarea", "id": "fountain_features", "label": "Fountain features" },
    { "type": "header", "content": "Feeder FAQ" },
    { "type": "text", "id": "dq1", "label": "Q1" }, { "type": "textarea", "id": "da1", "label": "A1" },
    { "type": "text", "id": "dq2", "label": "Q2" }, { "type": "textarea", "id": "da2", "label": "A2" },
    { "type": "text", "id": "dq3", "label": "Q3" }, { "type": "textarea", "id": "da3", "label": "A3" },
    { "type": "text", "id": "dq4", "label": "Q4" }, { "type": "textarea", "id": "da4", "label": "A4" },
    { "type": "text", "id": "dq5", "label": "Q5" }, { "type": "textarea", "id": "da5", "label": "A5" },
    { "type": "header", "content": "Fountain FAQ" },
    { "type": "text", "id": "fq1", "label": "Q1" }, { "type": "textarea", "id": "fa1", "label": "A1" },
    { "type": "text", "id": "fq2", "label": "Q2" }, { "type": "textarea", "id": "fa2", "label": "A2" },
    { "type": "text", "id": "fq3", "label": "Q3" }, { "type": "textarea", "id": "fa3", "label": "A3" },
    { "type": "text", "id": "fq4", "label": "Q4" }, { "type": "textarea", "id": "fa4", "label": "A4" },
    { "type": "text", "id": "fq5", "label": "Q5" }, { "type": "textarea", "id": "fa5", "label": "A5" },
    { "type": "header", "content": "Complete the setup" },
    { "type": "text", "id": "pair_eyebrow", "label": "Eyebrow", "default": "Complete the setup" },
    { "type": "text", "id": "pair_button", "label": "Button", "default": "View" },
    { "type": "product", "id": "pair_for_feeder", "label": "Show on feeder pages" },
    { "type": "product", "id": "pair_for_fountain", "label": "Show on fountain pages" }
  ],
  "presets": [{ "name": "PETME2 product extras" }]
}
{% endschema %}
