{%- comment -%}
  PETME2 "coming soon" teaser for the supplement line (homepage).
  Dark forest green + gold, the same look as the supplement boxes. Two lists (cats / dogs),
  early-access email sign-up (Shopify customer form, tags newsletter + coming-soon), true trust points only.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign fid = 'Pm2SoonHome-' | append: section.id
-%}
<section class="pm2-soon-h" style="--pm2-pt: {{ s.padding_top }}px; --pm2-pb: {{ s.padding_bottom }}px;" aria-labelledby="Pm2SoonTitle-{{ section.id }}">
  <div class="page-width">
    <div class="pm2-soon-h__card">
      <div class="pm2-soon-h__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag: class: 'pm2-soon-h__img', loading: 'lazy', widths: '480, 720, 960, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: s.image.alt | default: 'PETME2 supplement soft chews for cats and dogs' }}
        {%- endif -%}
        <span class="pm2-soon-h__ribbon">{{ s.ribbon | escape }}</span>
      </div>

      <div class="pm2-soon-h__body">
        {%- if s.eyebrow != blank -%}<p class="pm2-soon-h__eyebrow"><span class="pm2-soon-h__dot" aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Pm2SoonTitle-{{ section.id }}" class="pm2-soon-h__title">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="pm2-soon-h__text">{{ s.text | escape }}</p>{%- endif -%}

        <div class="pm2-soon-h__lists">
          <div class="pm2-soon-h__list">
            <p class="pm2-soon-h__who">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 4l3 4h8l3-4v9a7 7 0 0 1-14 0z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="9.5" cy="12.5" r="1" fill="currentColor"/><circle cx="14.5" cy="12.5" r="1" fill="currentColor"/></svg>
              For cats
            </p>
            <ul role="list">{%- assign cats_items = s.cats | newline_to_br | split: '<br />' -%}{%- for item in cats_items -%}{%- assign t = item | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
          </div>
          <div class="pm2-soon-h__list">
            <p class="pm2-soon-h__who">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 9c-1.5 0-3-1-3-3l2-1 2 2M18 9c1.5 0 3-1 3-3l-2-1-2 2M7 8h10l1 6a6 6 0 0 1-12 0z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="10" cy="12.5" r="1" fill="currentColor"/><circle cx="14" cy="12.5" r="1" fill="currentColor"/></svg>
              For dogs
            </p>
            <ul role="list">{%- assign dogs_items = s.dogs | newline_to_br | split: '<br />' -%}{%- for item in dogs_items -%}{%- assign t = item | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
          </div>
        </div>

        <div class="pm2-soon-h__signup">
          <p class="pm2-soon-h__signup-title">{{ s.signup_title | escape }}</p>
          {%- form 'customer', id: fid, class: 'pm2-soon-h__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,coming-soon,coming-soon-supplements">
            {%- if form.posted_successfully? -%}
              <p class="pm2-soon-h__ok" role="status">{{ s.success_text | escape }}</p>
            {%- else -%}
              <label class="visually-hidden" for="{{ fid }}-email">Email</label>
              <input id="{{ fid }}-email" class="pm2-soon-h__input" type="email" name="contact[email]" required autocomplete="email" placeholder="Your email">
              <button type="submit" class="pm2-soon-h__btn">{{ s.button_label | escape }}</button>
              {%- if form.errors -%}<p class="pm2-soon-h__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
          {%- if s.link_label != blank -%}<a class="pm2-soon-h__link" href="{{ s.link_url | default: '/collections/supplements' }}">{{ s.link_label | escape }} &rarr;</a>{%- endif -%}
        </div>

        <ul class="pm2-soon-h__trust" role="list">
          {%- for i in (1..4) -%}
            {%- capture key -%}trust_{{ i }}{%- endcapture -%}
            {%- assign t = s[key] -%}
            {%- if t != blank -%}
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pm2-soon-h { --g: #2A3B33; --g2: #22302A; --gold: #E9C46A; --gold2: #F3DFA2; padding: 24px 0 32px; }
  @media screen and (min-width: 750px) { .pm2-soon-h { padding: var(--pm2-pt, 56px) 0 var(--pm2-pb, 56px); } }
  .pm2-soon-h__card { display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; border-radius: 28px; color: #fff;
    background: radial-gradient(120% 90% at 100% 0%, rgba(233, 196, 106, .14), transparent 55%), linear-gradient(160deg, var(--g) 0%, var(--g2) 100%);
    box-shadow: 0 30px 60px -40px rgba(16, 28, 22, .7); }
  .pm2-soon-h__media { position: relative; aspect-ratio: 16 / 10; background: #1d2924; }
  .pm2-soon-h__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pm2-soon-h__ribbon { position: absolute; top: 14px; left: 14px; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #22302A; background: linear-gradient(90deg, var(--gold), var(--gold2)); box-shadow: 0 8px 20px -10px rgba(0, 0, 0, .6); }
  .pm2-soon-h__body { padding: 24px 20px 26px; }
  .pm2-soon-h__eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
  .pm2-soon-h__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 rgba(233, 196, 106, .6); }
  @media (prefers-reduced-motion: no-preference) { .pm2-soon-h__dot { animation: pm2-soon-pulse 2s ease-out infinite; } }
  @keyframes pm2-soon-pulse { 0% { box-shadow: 0 0 0 0 rgba(233, 196, 106, .6); } 80%, 100% { box-shadow: 0 0 0 10px rgba(233, 196, 106, 0); } }
  .pm2-soon-h__title { margin: 0; color: #fff; font-size: clamp(28px, 7.4vw, 44px); line-height: 1.08; letter-spacing: -.02em; text-wrap: balance; }
  .pm2-soon-h__text { margin: 10px 0 0; font-size: 15.5px; line-height: 1.55; color: rgba(255, 255, 255, .82); max-width: 50ch; }
  .pm2-soon-h__lists { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; }
  .pm2-soon-h__list { padding: 14px; border-radius: 18px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(233, 196, 106, .22); }
  .pm2-soon-h__who { display: flex; align-items: center; gap: 6px; margin: 0 0 8px; font-weight: 800; font-size: 14px; color: var(--gold); }
  .pm2-soon-h__list ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .pm2-soon-h__list li { font-size: 14px; line-height: 1.3; color: rgba(255, 255, 255, .92); padding-left: 14px; position: relative; }
  .pm2-soon-h__list li::before { content: ""; position: absolute; left: 0; top: .5em; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }
  .pm2-soon-h__signup { margin-top: 20px; }
  .pm2-soon-h__signup-title { margin: 0 0 8px; font-weight: 800; font-size: 15px; }
  .pm2-soon-h__form { display: flex; flex-wrap: wrap; gap: 8px; }
  .pm2-soon-h__input { flex: 1 1 200px; min-width: 0; min-height: 50px; padding: 0 18px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .28); background: rgba(255, 255, 255, .08); color: #fff; font-size: 16px; }
  .pm2-soon-h__input::placeholder { color: rgba(255, 255, 255, .6); }
  .pm2-soon-h__input:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .pm2-soon-h__btn { flex: 0 0 auto; min-height: 50px; padding: 0 24px; border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-weight: 800; font-size: 16px; color: #22302A; background: linear-gradient(90deg, var(--gold), var(--gold2)); }
  .pm2-soon-h__btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .pm2-soon-h__ok { margin: 0; font-weight: 700; color: var(--gold); }
  .pm2-soon-h__err { flex-basis: 100%; margin: 0; font-size: 14px; color: #FFB4A9; }
  .pm2-soon-h__link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 4px; font-weight: 700; font-size: 15px; color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .pm2-soon-h__trust { list-style: none; margin: 14px 0 0; padding: 14px 0 0; border-top: 1px solid rgba(255, 255, 255, .12); display: grid; grid-template-columns: 1fr; gap: 8px; }
  .pm2-soon-h__trust li { display: flex; align-items: center; gap: 8px; font-size: 14px; color: rgba(255, 255, 255, .86); }
  .pm2-soon-h__trust svg { flex: none; color: var(--gold); }
  @media screen and (max-width: 749px) { .pm2-soon-h__btn { flex: 1 1 100%; } }
  @media screen and (min-width: 750px) {
    .pm2-soon-h__trust { grid-template-columns: 1fr 1fr; }
    .pm2-soon-h__body { padding: 34px 36px; }
  }
  @media screen and (min-width: 990px) {
    .pm2-soon-h__card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-radius: 32px; }
    .pm2-soon-h__media { aspect-ratio: auto; min-height: 100%; }
    .pm2-soon-h__body { padding: 44px 48px; align-self: center; }
    .pm2-soon-h__ribbon { top: 20px; left: 20px; }
  }
</style>

{% schema %}
{
  "name": "PETME2 coming soon",
  "tag": "div",
  "class": "pm2-soon-supplements-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "ribbon", "label": "Ribbon on image", "default": "Coming soon" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New from PETME2" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Supplements for cats & dogs" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "cats", "label": "Cat products (one per line)" },
    { "type": "textarea", "id": "dogs", "label": "Dog products (one per line)" },
    { "type": "text", "id": "signup_title", "label": "Sign-up title", "default": "Be first to know when they launch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "success_text", "label": "Thank-you text", "default": "You're on the list! We'll email you on launch day." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the line-up" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "trust_1", "label": "Trust point 1" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3" },
    { "type": "text", "id": "trust_4", "label": "Trust point 4" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "PETME2 coming soon" }]
}
{% endschema %}
