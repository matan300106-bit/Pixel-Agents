{%- comment -%}
  PETME2 risk-reversal band: icon + "Love it or your money back" + short text + row of real promises
  (free U.S. shipping, 30-day money-back, secure checkout) + optional button.
  Styles: "card" (rounded card inside the page width) or "band" (full-width strip).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<div class="pm2-g-wrap{% if s.style == 'band' %} color-{{ s.color_scheme }} gradient{% endif %}">
  <div class="page-width pm2-g-outer" style="--pm2-pt: {{ s.padding_top }}px; --pm2-pb: {{ s.padding_bottom }}px;">
    <div class="pm2-g pm2-g--{{ s.style }}{% if s.style == 'card' %} color-{{ s.color_scheme }} gradient{% endif %}">
      <span class="pm2-g__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          {%- if s.icon == 'heart' -%}
            <path d="M24 40s-15-8.6-15-19.2A8.4 8.4 0 0 1 24 15.6a8.4 8.4 0 0 1 15 5.2C39 31.4 24 40 24 40z"/>
          {%- elsif s.icon == 'paw_heart' -%}
            <path d="M24 6l14 5.6v10.2c0 9-6 15.8-14 18.2-8-2.4-14-9.2-14-18.2V11.6z"/><path d="M24 31s-6.5-3.7-6.5-8.2a3.6 3.6 0 0 1 6.5-2.1 3.6 3.6 0 0 1 6.5 2.1c0 4.5-6.5 8.2-6.5 8.2z"/>
          {%- else -%}
            <path d="M24 6l14 5.6v10.2c0 9-6 15.8-14 18.2-8-2.4-14-9.2-14-18.2V11.6z"/><path d="M17.5 23.5l4.6 4.6 8.4-8.6"/>
          {%- endif -%}
        </svg>
      </span>
      <div class="pm2-g__body">
        {%- if s.heading != blank -%}
          <h2 class="pm2-g__title {{ s.heading_size }}">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="pm2-g__text">{{ s.text | escape }}</p>
        {%- endif -%}
        {%- if s.point_1 != blank or s.point_2 != blank or s.point_3 != blank -%}
          <ul class="pm2-g__points" role="list">
            {%- if s.point_1 != blank -%}
              <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><circle cx="6.5" cy="17" r="1.9" fill="none" stroke="currentColor" stroke-width="1.9"/><circle cx="17" cy="17" r="1.9" fill="none" stroke="currentColor" stroke-width="1.9"/></svg>{{ s.point_1 | escape }}</li>
            {%- endif -%}
            {%- if s.point_2 != blank -%}
              <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ s.point_2 | escape }}</li>
            {%- endif -%}
            {%- if s.point_3 != blank -%}
              <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="5" y="10.5" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7" fill="none" stroke="currentColor" stroke-width="1.9"/></svg>{{ s.point_3 | escape }}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if s.button_label != blank -%}
        <a
          class="button pm2-g__btn{% if s.button_secondary %} button--secondary{% endif %}"
          {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        >{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .pm2-g-outer { padding-top: var(--pm2-pt); padding-bottom: var(--pm2-pb); }
  .pm2-g {
    display: grid; grid-template-columns: auto 1fr; gap: 1.6rem 2rem; align-items: start;
    color: rgb(var(--color-foreground));
  }
  .pm2-g--card {
    padding: 2.8rem 2.2rem; border-radius: 24px;
    box-shadow: 0 18px 40px -28px rgba(17, 24, 39, .45), inset 0 0 0 1px rgba(var(--color-foreground), .05);
  }
  .pm2-g__icon {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 999px;
    background: rgb(var(--color-background)); color: rgb(var(--color-button));
    box-shadow: 0 8px 22px -10px rgba(var(--color-foreground), .4), inset 0 0 0 1px rgba(var(--color-foreground), .06);
  }
  .pm2-g--card .pm2-g__icon { background: rgba(var(--color-button), .1); box-shadow: none; }
  .pm2-g__body { min-width: 0; }
  .pm2-g__title { margin: 0; font-weight: 800; line-height: 1.15; letter-spacing: -.01em; text-wrap: balance; }
  .pm2-g__text { margin: .8rem 0 0; font-size: 1.6rem; line-height: 1.5; color: rgba(var(--color-foreground), .75); max-width: 56rem; }
  .pm2-g__points {
    list-style: none; margin: 1.4rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: .8rem 1.8rem;
    font-size: 1.4rem; font-weight: 700; letter-spacing: normal;
  }
  .pm2-g__points li { display: inline-flex; align-items: center; gap: .6rem; }
  .pm2-g__points svg { flex: 0 0 auto; color: rgb(var(--color-button)); }
  .pm2-g .button.pm2-g__btn { box-sizing: border-box; max-width: 100%; grid-column: 1 / -1; min-height: 4.8rem; border-radius: 999px; font-weight: 700; text-decoration: none; }
  .pm2-g .button.pm2-g__btn::after { border-radius: 999px; }
  @media screen and (max-width: 749px) {
    .pm2-g { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .pm2-g__points { justify-content: center; }
    .pm2-g .button.pm2-g__btn { justify-self: stretch; width: auto; min-width: 0; }
  }
  @media screen and (min-width: 750px) {
    .pm2-g { grid-template-columns: auto 1fr auto; align-items: center; gap: 2.8rem; }
    .pm2-g--card { padding: 3.6rem 4rem; }
    .pm2-g__icon { width: 84px; height: 84px; }
    .pm2-g__icon svg { width: 48px; height: 48px; }
    .pm2-g .button.pm2-g__btn { grid-column: auto; padding: 0 3rem; }
  }
</style>

{% schema %}
{
  "name": "PM2 Money-back guarantee",
  "tag": "section",
  "class": "section pm2-g-section",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "shield", "label": "Shield with check" },
        { "value": "heart", "label": "Heart" },
        { "value": "paw_heart", "label": "Shield with heart" }
      ],
      "default": "shield"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Love it or your money back" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h2"
    },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Try it for 30 days. If you or your pet aren't happy, we'll refund you." },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Free U.S. shipping" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "30-day money-back" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Secure checkout" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_secondary", "label": "Outline button style", "default": false },
    { "type": "header", "content": "Look" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "card", "label": "Rounded card" },
        { "value": "band", "label": "Full-width band" }
      ],
      "default": "card"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [
    { "name": "PM2 Money-back guarantee" }
  ]
}
{% endschema %}
