{%- comment -%}
  PETME2 split hero: pill eyebrow, big gradient headline, 2 CTAs, trust chips,
  product shot on a glass card + optional lifestyle photo + floating spec badges.
  Styles are static and prefixed .pm2-hero; per-instance values go through inline CSS vars.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hero_product = s.product
-%}
<section
  class="pm2-hero color-{{ s.color_scheme }} gradient{% if s.show_grid %} pm2-hero--grid{% endif %}"
  style="--pm2-pt: {{ s.padding_top }}px; --pm2-pb: {{ s.padding_bottom }}px;"
  aria-labelledby="Pm2HeroHeading-{{ section.id }}"
>
  <div class="pm2-hero__bg" aria-hidden="true">
    <span class="pm2-hero__blob pm2-hero__blob--a"></span>
    <span class="pm2-hero__blob pm2-hero__blob--b"></span>
  </div>

  <div class="page-width pm2-hero__inner">
    <div class="pm2-hero__copy">
      {%- if s.eyebrow != blank or s.eyebrow_tag != blank -%}
        <p class="pm2-hero__eyebrow">
          {%- if s.eyebrow_tag != blank -%}<span class="pm2-hero__eyebrow-tag">{{ s.eyebrow_tag | escape }}</span>{%- endif -%}
          <span class="pm2-hero__eyebrow-text">{{ s.eyebrow | escape }}</span>
        </p>
      {%- endif -%}

      <h1 id="Pm2HeroHeading-{{ section.id }}" class="pm2-hero__title">
        {%- if s.heading_line_1 != blank -%}<span class="pm2-hero__title-line">{{ s.heading_line_1 | escape }}</span>{%- endif -%}
        {%- if s.heading_highlight != blank -%}<span class="pm2-hero__title-grad">{{ s.heading_highlight | escape }}</span>{%- endif -%}
      </h1>

      {%- if s.subtext != blank -%}
        <p class="pm2-hero__sub">{{ s.subtext | escape }}</p>
      {%- endif -%}

      {%- if s.button_label_1 != blank or s.button_label_2 != blank -%}
        <div class="pm2-hero__ctas">
          {%- if s.button_label_1 != blank -%}
            <a class="button pm2-hero__btn"{% if s.button_link_1 != blank %} href="{{ s.button_link_1 }}"{% else %} role="link" aria-disabled="true"{% endif %}>
              {{ s.button_label_1 | escape }}
              <svg class="pm2-hero__btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            <a class="button button--secondary pm2-hero__btn pm2-hero__btn--ghost"{% if s.button_link_2 != blank %} href="{{ s.button_link_2 }}"{% else %} role="link" aria-disabled="true"{% endif %}>
              {{ s.button_label_2 | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.chip_1 != blank or s.chip_2 != blank or s.chip_3 != blank -%}
        <ul class="pm2-hero__chips" role="list">
          {%- if s.chip_1 != blank -%}
            <li class="pm2-hero__chip">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" fill="currentColor"/><circle cx="17" cy="17.5" r="1.7" fill="currentColor"/></svg>
              {{ s.chip_1 | escape }}
            </li>
          {%- endif -%}
          {%- if s.chip_2 != blank -%}
            <li class="pm2-hero__chip">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 18h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              {{ s.chip_2 | escape }}
            </li>
          {%- endif -%}
          {%- if s.chip_3 != blank -%}
            <li class="pm2-hero__chip">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              {{ s.chip_3 | escape }}
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="pm2-hero__visual{% if s.image != blank %} pm2-hero__visual--has-photo{% endif %}">
      <span class="pm2-hero__glow" aria-hidden="true"></span>

      {%- if s.image != blank -%}
        <div class="pm2-hero__photo">
          {{
            s.image
            | image_url: width: 1000
            | image_tag:
              loading: 'eager',
              widths: '360, 540, 720, 1000',
              sizes: '(min-width: 990px) 26vw, 92vw',
              alt: s.image.alt
          }}
        </div>
      {%- endif -%}

      <div class="pm2-hero__card">
        {%- if hero_product != blank and hero_product.featured_image != blank -%}
          {%- if s.link_product -%}<a class="pm2-hero__card-link" href="{{ hero_product.url }}" aria-label="{{ hero_product.title | escape }}">{%- endif -%}
          {{
            hero_product.featured_image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 990px) 40vw, (min-width: 750px) 480px, 80vw',
              alt: hero_product.featured_image.alt,
              class: 'pm2-hero__product-img'
          }}
          {%- if s.link_product -%}</a>{%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pm2-hero__product-img pm2-hero__placeholder' }}
        {%- endif -%}
      </div>

      {%- if s.badge_1 != blank -%}
        <div class="pm2-hero__badge pm2-hero__badge--1">
          <span class="pm2-hero__badge-ico" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" focusable="false"><path d="M3 8a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.8"/><path d="M16 10.5l5-3v9l-5-3" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </span>
          <span>{{ s.badge_1 | escape }}</span>
        </div>
      {%- endif -%}
      {%- if s.badge_2 != blank -%}
        <div class="pm2-hero__badge pm2-hero__badge--2">
          <span class="pm2-hero__badge-ico" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" focusable="false"><path d="M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <span>{{ s.badge_2 | escape }}</span>
        </div>
      {%- endif -%}
      {%- if s.badge_3 != blank -%}
        <div class="pm2-hero__badge pm2-hero__badge--3">
          <span class="pm2-hero__badge-ico" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" focusable="false"><path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.7 16a5 5 0 0 1 6.6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="19.3" r="1.4" fill="currentColor"/></svg>
          </span>
          <span>{{ s.badge_3 | escape }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  /* All colours derive from the Dawn scheme vars, so the hero reads well on white (scheme-3/5) and navy (scheme-1). */
  .pm2-hero {
    --pm2-accent: var(--color-button);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: clamp(28px, calc(var(--pm2-pt, 96px) * .45), 56px);
    padding-bottom: clamp(32px, calc(var(--pm2-pb, 96px) * .5), 64px);
    color: rgb(var(--color-foreground));
  }
  @media screen and (min-width: 990px) {
    .pm2-hero { padding-top: var(--pm2-pt, 96px); padding-bottom: var(--pm2-pb, 96px); }
  }

  /* ---------- background: soft accent haze + optional faint grid ---------- */
  .pm2-hero__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .pm2-hero__blob { position: absolute; border-radius: 50%; filter: blur(70px); }
  .pm2-hero__blob--a {
    width: 520px; height: 520px; right: -180px; top: -200px; opacity: .32;
    background: radial-gradient(circle, rgba(var(--pm2-accent), .8), rgba(var(--pm2-accent), 0) 70%);
  }
  .pm2-hero__blob--b {
    width: 380px; height: 380px; left: -200px; bottom: -220px; opacity: .18;
    background: radial-gradient(circle, rgba(var(--pm2-accent), .7), rgba(var(--pm2-accent), 0) 70%);
  }
  .pm2-hero--grid .pm2-hero__bg::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(var(--color-foreground), .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--color-foreground), .035) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 35%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 70% 60% at 65% 35%, #000 10%, transparent 70%);
  }

  /* ---------- layout: copy first on phones, visual second ---------- */
  .pm2-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  @media screen and (min-width: 750px) { .pm2-hero__inner { gap: 40px; } }
  @media screen and (min-width: 990px) {
    .pm2-hero__inner { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: 56px; }
  }

  /* ---------- copy ---------- */
  .pm2-hero__copy { max-width: 640px; min-width: 0; }
  .pm2-hero__eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    max-width: 100%;
    margin: 0 0 18px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    font-size: 14px; line-height: 1.4; letter-spacing: .01em; font-weight: 500;
    color: rgba(var(--color-foreground), .82);
    background: rgba(var(--color-foreground), .05);
    border: 1px solid rgba(var(--color-foreground), .08);
  }
  .pm2-hero__eyebrow-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pm2-hero__eyebrow-tag {
    flex: none;
    padding: 3px 10px; border-radius: 999px;
    font-weight: 600; font-size: 12px;
    color: rgb(var(--color-button-text));
    background: rgb(var(--pm2-accent));
  }
  .pm2-hero__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(36px, 10.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: rgb(var(--color-foreground));
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  @media screen and (min-width: 750px) { .pm2-hero__title { font-size: clamp(52px, 7.2vw, 68px); } }
  @media screen and (min-width: 990px) { .pm2-hero__title { font-size: clamp(56px, 5.4vw, 80px); line-height: 1.02; } }
  .pm2-hero__title-line, .pm2-hero__title-grad { display: block; }
  .pm2-hero__title-grad {
    padding-bottom: .08em; /* keep descenders inside the clipped gradient */
    color: rgb(var(--pm2-accent));
    background: linear-gradient(92deg, rgb(var(--pm2-accent)) 0%, rgba(var(--pm2-accent), .72) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .pm2-hero__sub {
    margin: 16px 0 0;
    max-width: 52ch;
    font-size: 16px; line-height: 1.6; letter-spacing: 0;
    color: rgba(var(--color-foreground), .72);
  }
  @media screen and (min-width: 750px) { .pm2-hero__sub { font-size: 18px; margin-top: 22px; } }
  @media screen and (min-width: 990px) { .pm2-hero__sub { font-size: 19px; } }

  .pm2-hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media screen and (min-width: 990px) { .pm2-hero__ctas { margin-top: 34px; } }
  .pm2-hero .pm2-hero__btn { gap: 10px; min-height: 52px; padding: 0 28px; font-size: 16px; font-weight: 600; letter-spacing: 0; border-radius: 999px; }
  .pm2-hero .pm2-hero__btn::before, .pm2-hero .pm2-hero__btn::after { border-radius: 999px; }
  .pm2-hero__btn:not(.button--secondary) { box-shadow: 0 10px 24px -14px rgba(var(--pm2-accent), .9); }
  .pm2-hero .pm2-hero__btn:not(.button--secondary) { min-height: 58px; padding: 0 36px; font-size: 17px; font-weight: 700; }
  .pm2-hero__btn-arrow { transition: transform .25s ease; }
  .pm2-hero__btn:hover .pm2-hero__btn-arrow { transform: translateX(3px); }
  .pm2-hero__btn--ghost { background: rgba(var(--color-foreground), .04); }
  @media screen and (max-width: 749px) {
    .pm2-hero__ctas { flex-direction: column; }
    .pm2-hero__ctas .pm2-hero__btn { width: 100%; }
  }

  .pm2-hero__chips {
    display: flex; flex-wrap: wrap; gap: 8px;
    list-style: none; margin: 22px 0 0; padding: 0;
  }
  @media screen and (min-width: 990px) { .pm2-hero__chips { margin-top: 30px; } }
  .pm2-hero__chip {
    display: inline-flex; align-items: center; gap: 7px;
    min-height: 34px; padding: 6px 13px; border-radius: 999px;
    font-size: 14px; line-height: 1.3; letter-spacing: 0;
    color: rgba(var(--color-foreground), .8);
    border: 1px solid rgba(var(--color-foreground), .08);
    background: rgba(var(--color-foreground), .03);
  }
  .pm2-hero__chip svg { color: rgb(var(--pm2-accent)); flex: none; }

  /* ---------- visual ---------- */
  .pm2-hero__visual {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    aspect-ratio: 1 / 1.02;
  }
  .pm2-hero__glow {
    position: absolute; inset: 10% 8% 6%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, rgba(var(--pm2-accent), .28), rgba(var(--pm2-accent), .06) 50%, transparent 70%);
    filter: blur(30px);
  }
  .pm2-hero__card {
    position: absolute;
    inset: 9% 6% 5% 6%;
    display: flex; align-items: center; justify-content: center;
    padding: 9%;
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(var(--color-background), .55), rgba(var(--color-background), .2)),
      rgba(var(--color-foreground), .04);
    border: 1px solid rgba(var(--color-foreground), .08);
    box-shadow: 0 30px 60px -36px rgba(var(--color-shadow, 0, 0, 0), .35);
  }
  .pm2-hero__card-link { display: contents; }
  .pm2-hero__product-img {
    position: relative;
    width: 100%; height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 20px 26px rgba(var(--color-shadow, 0, 0, 0), .18));
  }
  .pm2-hero__placeholder { fill: rgba(var(--color-foreground), .35); background: transparent; }

  .pm2-hero__visual--has-photo .pm2-hero__card { inset: 14% 16% 4% 0; }
  .pm2-hero__photo {
    position: absolute;
    top: 0; right: 0;
    width: 50%; aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    transform: rotate(4deg);
    border: 1px solid rgba(var(--color-foreground), .08);
    box-shadow: 0 24px 48px -28px rgba(var(--color-shadow, 0, 0, 0), .4);
  }
  .pm2-hero__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pm2-hero__badge {
    position: absolute;
    z-index: 2;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 14px 7px 7px;
    border-radius: 999px;
    font-size: 14px; font-weight: 600; line-height: 1.2; letter-spacing: 0;
    white-space: nowrap;
    color: rgb(var(--color-foreground));
    background: rgba(var(--color-background), .92);
    border: 1px solid rgba(var(--color-foreground), .08);
    box-shadow: 0 12px 28px -16px rgba(var(--color-shadow, 0, 0, 0), .35);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    animation: pm2-hero-float 8s ease-in-out infinite;
  }
  .pm2-hero__badge-ico {
    flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 50%;
    color: rgb(var(--color-button-text));
    background: rgb(var(--pm2-accent));
  }
  .pm2-hero__badge--1 { left: 0; top: 16%; }
  .pm2-hero__badge--2 { right: 0; bottom: 18%; animation-delay: -2.6s; }
  .pm2-hero__badge--3 { left: 8%; bottom: 0; animation-delay: -5.2s; }
  .pm2-hero__visual--has-photo .pm2-hero__badge--2 { right: 4%; }

  /* Phones/tablets: compact product card (never taller than ~55vh), no tilted photo,
     badges become a calm wrapped row under the card so they can never cover text or leave the screen. */
  @media screen and (max-width: 989px) {
    .pm2-hero__visual,
    .pm2-hero__visual--has-photo {
      aspect-ratio: auto;
      display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
      max-width: 520px;
    }
    .pm2-hero__photo { display: none; }
    /* with a lifestyle photo: the pet photo is the hero visual on phones */
    .pm2-hero__visual--has-photo .pm2-hero__photo {
      display: block; position: relative; top: auto; right: auto;
      flex: 0 0 100%; width: 100%; aspect-ratio: 4 / 3; max-height: 52vh;
      transform: none; border-radius: 24px;
    }
    .pm2-hero__visual--has-photo .pm2-hero__card,
    .pm2-hero__visual--has-photo .pm2-hero__badge { display: none; }
    .pm2-hero__card,
    .pm2-hero__visual--has-photo .pm2-hero__card {
      position: relative; inset: auto;
      flex: 0 0 100%;
      height: min(46vh, 86vw, 440px);
      min-height: 220px;
      padding: 7%;
      border-radius: 24px;
      margin-bottom: 6px;
    }
    .pm2-hero__glow { inset: 6% 10% 30%; }
    .pm2-hero__badge,
    .pm2-hero__visual--has-photo .pm2-hero__badge--2 {
      position: static;
      animation: none;
      max-width: 100%;
      padding: 6px 12px 6px 6px; gap: 8px;
      font-size: 14px;
      box-shadow: none;
      background: rgba(var(--color-foreground), .04);
      -webkit-backdrop-filter: none; backdrop-filter: none;
    }
    .pm2-hero__badge > span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .pm2-hero__badge-ico { width: 24px; height: 24px; }
    .pm2-hero__badge-ico svg { width: 14px; height: 14px; }
  }

  @keyframes pm2-hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* entrance */
  @media (prefers-reduced-motion: no-preference) {
    .pm2-hero__copy > *, .pm2-hero__visual { animation: pm2-hero-in .7s cubic-bezier(.2, .7, .2, 1) both; }
    .pm2-hero__copy > :nth-child(2) { animation-delay: .05s; }
    .pm2-hero__copy > :nth-child(3) { animation-delay: .1s; }
    .pm2-hero__copy > :nth-child(4) { animation-delay: .15s; }
    .pm2-hero__copy > :nth-child(5) { animation-delay: .2s; }
    .pm2-hero__visual { animation-delay: .1s; animation-duration: .9s; }
  }
  @keyframes pm2-hero-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm2-hero__badge { animation: none; }
    .pm2-hero__btn-arrow { transition: none; }
  }
</style>

{% schema %}
{
  "name": "PETME2 hero",
  "tag": "div",
  "class": "pm2-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_grid", "label": "Show background grid", "default": true },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow_tag", "label": "Eyebrow tag", "default": "New" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Smart feeders & fountains" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Smart feeding." },
    { "type": "text", "id": "heading_highlight", "label": "Heading line 2 (gradient)", "default": "Zero guesswork." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "App-controlled automatic feeders and quiet water fountains for cats and small dogs. Schedule meals, check in, and keep fresh water flowing." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Shop feeders" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Shop fountains" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "header", "content": "Trust chips" },
    { "type": "text", "id": "chip_1", "label": "Chip 1 (truck icon)", "default": "Free U.S. shipping" },
    { "type": "text", "id": "chip_2", "label": "Chip 2 (phone icon)", "default": "App control" },
    { "type": "text", "id": "chip_3", "label": "Chip 3 (drop icon)", "default": "Quiet pumps" },
    { "type": "header", "content": "Visual" },
    { "type": "product", "id": "product", "label": "Hero product", "info": "Its featured image is shown on the glass card. Use a transparent or light-background PNG for best results." },
    { "type": "checkbox", "id": "link_product", "label": "Link image to product", "default": true },
