{%- comment -%}
  PETME2: Ahrefs Web Analytics tag. Loads on every page (header group).
  The data-key is public (it is visible in the page source on every site that uses Ahrefs).
{%- endcomment -%}
{%- if section.settings.enabled and section.settings.data_key != blank -%}
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="{{ section.settings.data_key | escape }}" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Ahrefs analytics",
  "tag": "div",
  "class": "pm2-ahrefs-analytics",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Turn on Ahrefs analytics", "default": true },
    { "type": "text", "id": "data_key", "label": "Ahrefs data-key", "default": "/T5c1ngTg1eI29SYFzuY5g" }
  ]
}
{% endschema %}
