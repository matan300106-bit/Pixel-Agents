{%- comment -%}
  PETME2 product highlights: "Made for real life", a simple day-in-the-life strip that replaces the
  reviews block. Honest by design: no stars, no ratings, no quotes, only what the product does.
  Feeder or fountain lines are chosen from product.type / handle (same rule as pm2-product-extras).
  Optional per-product override: metafield custom.highlights (one per line: "Time :: Title :: Short text").
  Mobile: horizontal scroll-snap row (contained, no page overflow). Desktop: 4-column timeline.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign is_fountain = false
  assign ptype = product.type | downcase
  if ptype contains 'fountain' or product.handle contains 'fountain'
    assign is_fountain = true
  endif
  assign raw = product.metafields.custom.highlights.value | default: '' | strip
  if raw == blank
    if is_fountain
      assign raw = s.fountain_moments
    else
      assign raw = s.feeder_moments
    endif
  endif
  assign lines = raw | newline_to_br | split: '<br />'
-%}
{%- capture icons -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>|~|<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg>|~|<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>|~|<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
{%- endcapture -%}
{%- assign icon_list = icons | split: '|~|' -%}

<div
  class="color-{{ s.color_scheme }} gradient pm2-hl"
  style="--pm2-pt: {{ s.padding_top }}px; --pm2-pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="pm2-hl__head">
      {%- if s.eyebrow != blank -%}<p class="pm2-hl__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="pm2-hl__title">{{ s.heading | escape }}</h2>{%- endif -%}
    </header>
    <ol class="pm2-hl__row" role="list">
      {%- assign n = 0 -%}
      {%- for line in lines -%}
        {%- assign line = line | strip -%}
        {%- if line == blank -%}{%- continue -%}{%- endif -%}
        {%- assign parts = line | split: '::' -%}
        {%- assign icon_i = n | modulo: 4 -%}
        <li class="pm2-hl__card">
          <span class="pm2-hl__icon" aria-hidden="true">{{ icon_list[icon_i] }}</span>
          <span class="pm2-hl__time">{{ parts[0] | strip | escape }}</span>
          <h3 class="pm2-hl__card-title">{{ parts[1] | strip | escape }}</h3>
          {%- if parts[2] != blank -%}<p class="pm2-hl__text">{{ parts[2] | strip | escape }}</p>{%- endif -%}
        </li>
        {%- assign n = n | plus: 1 -%}
      {%- endfor -%}
    </ol>
  </div>
</div>

<style>
  .pm2-hl { padding: var(--pm2-pt, 48px) 0 var(--pm2-pb, 48px); overflow-x: clip; }
  .pm2-hl__head { max-width: 640px; margin: 0 auto 24px; text-align: center; }
  .pm2-hl__eyebrow { margin: 0 0 8px; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(var(--color-foreground), .6); }
  .pm2-hl__title { margin: 0; font-size: clamp(26px, 3.6vw, 40px); line-height: 1.12; letter-spacing: -.02em; }
  .pm2-hl__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; counter-reset: pm2hl; }
  .pm2-hl__card { position: relative; display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 22px 22px 24px; border-radius: 24px; background: rgba(255, 255, 255, .92); box-shadow: 0 1px 0 rgba(var(--color-foreground), .06), 0 12px 30px -18px rgba(var(--color-foreground), .25); }
  .pm2-hl__icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-bottom: 8px; border-radius: 14px; background: rgba(var(--color-button), .1); color: rgb(var(--color-button)); }
  .pm2-hl__icon svg { width: 22px; height: 22px; }
  .pm2-hl__time { font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: rgba(var(--color-foreground), .55); }
  .pm2-hl__card-title { margin: 0; font-size: 20px; line-height: 1.2; }
  .pm2-hl__text { margin: 0; font-size: 15px; line-height: 1.5; color: rgba(var(--color-foreground), .72); }
  @media (max-width: 989px) {
    .pm2-hl__row { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(250px, 78%); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 16px; margin: 0 -1.5rem; padding: 4px 1.5rem 18px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .pm2-hl__row::-webkit-scrollbar { display: none; }
    .pm2-hl__card { scroll-snap-align: start; }
  }
</style>

{% schema %}
{
  "name": "PETME2 highlights",
  "tag": "section",
  "class": "pm2-hl-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Override per product with metafield custom.highlights. One per line: Time :: Title :: Short text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for real life" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A normal day, made easier" },
    { "type": "textarea", "id": "feeder_moments", "label": "Feeder lines (Time :: Title :: Short text)" },
    { "type": "textarea", "id": "fountain_moments", "label": "Fountain lines (Time :: Title :: Short text)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "PETME2 highlights" }]
}
{% endschema %}
