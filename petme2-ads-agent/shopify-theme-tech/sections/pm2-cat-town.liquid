{%- comment -%}
  PETME2 Cat Town (city engine v3): interactive 3D cat city. Generated by social/cat-town/build_shopify.py from viewer.html (catcity.html engine).
  Drag to look around, tap a house or a building, find your cat house. Residents come from the page metafield cattown.town (JSON). JS: assets/pm2-cat-city.js.
{%- endcomment -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Nunito+Sans:wght@400;600;700&display=swap">
<style>
  /* Layout: full-bleed 3D city, a floating counter on top, a control dock at the bottom. */
  .pm2-city { --sky: #CFE8F7; --ink: #1B2333; --panel: rgba(255,255,255,.94); --muted: #5B6475; --brand: #2F5FE0; --sun: #FFC93C; --line: rgba(27,35,51,.12);
    --display: 'Nunito', system-ui, sans-serif; --body: 'Nunito Sans', system-ui, sans-serif; }
  .pm2-city { position: relative; height: calc(100svh - var(--header-height, 64px)); min-height: 600px; overflow: hidden; background: var(--sky); color: var(--ink); font-family: var(--body); }
  .pm2-city #pcc-stage { position: absolute; inset: 0; }
  .pm2-city #pcc-stage canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  .pm2-city .top { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 14px); left: 16px; right: 16px; display: flex; flex-direction: column; align-items: center; gap: 6px; pointer-events: none; }
  .pm2-city .pill { font-family: var(--display); font-weight: 900; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); background: var(--panel); padding: 6px 14px; border-radius: 999px; box-shadow: 0 6px 20px rgba(0,0,0,.12); }
  .pm2-city #pcc-countN { font-family: var(--display); font-weight: 900; font-size: clamp(48px, 11vw, 84px); line-height: 1; color: #fff; -webkit-text-stroke: 8px #1B2333; paint-order: stroke fill; font-variant-numeric: tabular-nums; }
  .pm2-city #pcc-countL { font-family: var(--display); font-weight: 900; font-size: 15px; color: #fff; background: #1B2333; padding: 4px 14px; border-radius: 999px; }
  .pm2-city .dock { position: absolute; left: 16px; right: 16px; bottom: calc(env(safe-area-inset-bottom, 0px) + 16px); margin: 0 auto; max-width: 560px; background: var(--panel); border-radius: 22px; padding: 16px 18px; box-shadow: 0 16px 40px rgba(10,20,40,.22); display: grid; gap: 12px; }
  .pm2-city .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .pm2-city .dock label { font-family: var(--display); font-weight: 800; font-size: 15px; }
  .pm2-city .dock label small { font-family: var(--body); font-weight: 600; color: var(--muted); font-size: 13px; margin-left: 6px; }
  .pm2-city input[type=range] { width: 100%; accent-color: var(--brand); height: 28px; }
  .pm2-city .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .pm2-city button { font: 800 14px var(--display); color: var(--ink); background: transparent; border: 1.5px solid var(--line); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
  .pm2-city button:hover { border-color: var(--brand); color: var(--brand); }
  .pm2-city button:focus-visible, .pm2-city input:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .pm2-city #pcc-play { background: var(--brand); color: #fff; border-color: var(--brand); margin-left: auto; }
  .pm2-city #pcc-postcard { margin-left: auto; } #pcc-postcard + #pcc-play { margin-left: 0; }
  .pm2-city .pc { position: fixed; inset: 0; z-index: 10; display: grid; place-items: center; padding: calc(env(safe-area-inset-top, 0px) + 16px) 16px calc(env(safe-area-inset-bottom, 0px) + 16px); background: rgba(10,16,28,.62); }
  .pm2-city .pc[hidden] { display: none; }
  .pm2-city .pc__card { background: var(--panel); color: var(--ink); border-radius: 22px; padding: 14px; width: min(420px, 100%); max-height: 100%; box-sizing: border-box; display: grid; gap: 10px; box-shadow: 0 16px 40px rgba(10,20,40,.35); }
  .pm2-city .pc__card img { display: block; width: 100%; height: auto; max-height: calc(100dvh - 190px); object-fit: contain; border-radius: 12px; background: var(--sky); -webkit-touch-callout: default; user-select: auto; }
  .pm2-city .pc__card p { margin: 0; font-size: 13px; line-height: 1.4; color: var(--muted); text-align: center; }
  .pm2-city .pc__row { display: flex; justify-content: center; }
  .pm2-city .rules { font-size: 13px; line-height: 1.45; color: var(--muted); margin: 0; }
  .pm2-city .rules b { color: var(--ink); }
  @media (max-width: 520px) {.pm2-city .dock { padding: 12px 12px; gap: 8px; } .pm2-city .chips { flex-wrap: nowrap; gap: 6px; } .pm2-city .chips button { flex: 1 1 0; min-width: 0; padding: 6px 4px; font-size: 13px; white-space: nowrap; } .pm2-city .row button { padding: 6px 9px; font-size: 13px; } .pm2-city .row { gap: 6px; } .pm2-city .dock label { font-size: 14px; } .pm2-city .rules { font-size: 12px; } .pm2-city .dock label small { display: none; } }
  .pm2-city .info { position: absolute; left: 16px; right: 16px; bottom: calc(env(safe-area-inset-bottom, 0px) + var(--dockH, 210px) + 26px); margin: 0 auto; max-width: 300px; background: var(--panel); border-radius: 14px; padding: 8px 32px 8px 10px; box-shadow: 0 8px 22px rgba(10,20,40,.16); z-index: 5; }
  .pm2-city .info[hidden] { display: none; }
  .pm2-city #pcc-infoBody { display: flex; gap: 9px; align-items: flex-start; }
  .pm2-city .info__icon { font-size: 18px; line-height: 1; }
  .pm2-city .info__title { display: block; font: 900 14px/1.2 var(--display); color: var(--ink); overflow-wrap: anywhere; }
  .pm2-city .info__line { display: block; font-size: 12px; line-height: 1.3; color: var(--muted); margin-top: 2px; }
  .pm2-city .info__shop { display: inline-block; margin-top: 5px; padding: 0; background: none; color: var(--brand); font-weight: 700; font-size: 11.5px; text-decoration: underline; text-underline-offset: 2px; }
  .pm2-city .upd { font: 700 10.5px/1.3 var(--body); color: #1B2333; background: rgba(255,255,255,.8); padding: 2px 9px; border-radius: 999px; text-align: center; }
  .pm2-city .upd[hidden] { display: none; }
  .pm2-city .find { pointer-events: auto; display: flex; gap: 8px; width: 100%; min-width: 0; box-sizing: border-box; }
  .pm2-city .find[hidden] { display: none; }
  .pm2-city .find input { flex: 1 1 auto; width: 100%; min-width: 0; box-sizing: border-box; font: 700 16px var(--body); color: #1B2333; background: #fff; border: 2px solid #1B2333; border-radius: 999px; padding: 9px 16px; box-shadow: 0 6px 20px rgba(0,0,0,.12); }
  .pm2-city .find input:focus { outline: 3px solid var(--sun); outline-offset: 1px; }
  .pm2-city .find button { flex: none; box-sizing: border-box; font: 900 15px var(--display); color: #fff; background: var(--brand); border: 2px solid #1B2333; border-radius: 999px; padding: 9px 16px; cursor: pointer; }
  .pm2-city .info__note { display: block; font-size: 11px; line-height: 1.3; color: var(--brand); margin-top: 4px; font-weight: 700; }
  .pm2-city #pcc-infoClose { position: absolute; top: 5px; right: 5px; width: 24px; height: 24px; padding: 0; border-radius: 50%; font-size: 11px; }
  /* move-around pad (bottom right, above the dock) + first-visit hint */
  .pm2-city .pad { position: absolute; right: 16px; bottom: calc(env(safe-area-inset-bottom, 0px) + var(--dockH, 210px) + 28px); z-index: 4; display: grid; grid-template-columns: repeat(3, 48px); grid-template-rows: repeat(3, 48px); gap: 4px; padding: 6px; border-radius: 26px; background: var(--panel); background: color-mix(in srgb, var(--panel) 72%, transparent); box-shadow: 0 10px 28px rgba(10,20,40,.18); }
  .pm2-city .pad button { width: 48px; height: 48px; padding: 0; border-radius: 50%; border: 1.5px solid var(--line); background: transparent; color: var(--ink); font: 900 20px/1 var(--display); display: grid; place-items: center; touch-action: manipulation; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; transition: transform .08s, background .08s; }
  .pm2-city .pad button:hover { border-color: var(--brand); color: var(--brand); }
  .pm2-city .pad button.is-down, .pm2-city .pad button:active { transform: scale(.9); background: var(--brand); border-color: var(--brand); color: #fff; }
  .pm2-city .pad .pad__home { background: var(--brand); border-color: var(--brand); color: #fff; font-size: 18px; }
  .pm2-city .pad .pad__zoom { font-size: 24px; }
  .pm2-city .hint { position: absolute; left: 16px; right: 16px; top: calc(env(safe-area-inset-top, 0px) + clamp(150px, 11vw + 100px, 190px)); margin: 0 auto; max-width: 360px; text-align: center; background: #1B2333; color: #fff; font: 800 14px/1.35 var(--display); padding: 10px 14px; border-radius: 14px; box-shadow: 0 10px 28px rgba(10,20,40,.3); z-index: 4; pointer-events: none; opacity: 0; transition: opacity .45s; }
  .pm2-city .hint.is-on { opacity: 1; }
  .pm2-city .hint[hidden] { display: none; }
  .pm2-city #pcc-stage { user-select: none; -webkit-user-select: none; }
  .pm2-city .loading { position: absolute; inset: 0; display: grid; place-items: center; font: 900 18px var(--display); color: var(--ink); pointer-events: none; }
  .pm2-city.ready .loading { display: none; }

</style>
<section class="pm2-city" data-cat-city>
<div id="pcc-stage"></div>
<div class="loading">Building Cat Town&#8230;</div>
<div class="top"><span class="pill">&#128062; PETME2 Cat Town</span><b id="pcc-countN">1</b><span id="pcc-countL">cat &#183; day 1</span><span class="upd" id="pcc-upd" hidden></span></div>
<div class="dock">
  <form class="find" id="pcc-find" role="search" hidden><input id="pcc-findQ" type="search" placeholder="Search @yourname" aria-label="Find your cat house: your name, Instagram or TikTok" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search"><button type="submit">Find</button></form>
  <div class="row"><label for="pcc-grow">Followers <small>drag to grow the city</small></label><button id="pcc-postcard" type="button">Save postcard</button><button id="pcc-play" type="button">Play growth</button></div>
  <input id="pcc-grow" type="range" min="0" max="1000" step="1" value="1000" aria-label="Followers">
  <div class="chips"><button type="button" data-f="0">Day 1</button><button type="button" data-f="100">100</button><button type="button" data-f="250">250</button><button type="button" data-f="500">500</button><button type="button" data-f="1000">1,000</button></div>
  <p class="rules"><b>Every like</b> = a new cat. <b>Every follower</b> = a new house. <b>Most-liked comment</b> = we build it. Cats walk the streets; humans run the cat taxis. Tap a house to see who lives there; double-tap to fly there.</p>
</div>
<div class="pad" id="pcc-pad" role="group" aria-label="Move around the city">
  <span></span><button type="button" data-nav="up" aria-label="Move up">&#9650;</button><button type="button" class="pad__zoom" data-nav="in" aria-label="Zoom in">+</button>
  <button type="button" data-nav="left" aria-label="Move left">&#9664;</button><button type="button" class="pad__home" data-nav="home" aria-label="Back to the center">&#9678;</button><button type="button" data-nav="right" aria-label="Move right">&#9654;</button>
  <span></span><button type="button" data-nav="down" aria-label="Move down">&#9660;</button><button type="button" class="pad__zoom" data-nav="out" aria-label="Zoom out">&#8722;</button>
</div>
<div class="hint" id="pcc-hint" hidden aria-live="polite">Double-tap to fly there &#183; drag to look around &#183; tap a house</div>
<div class="info" id="pcc-info" hidden role="status"><div id="pcc-infoBody"></div><button id="pcc-infoClose" type="button" aria-label="Close">&#10005;</button></div>
<div class="pc" id="pcc-pcBox" hidden role="dialog" aria-modal="true" aria-labelledby="pcc-pcHint"><div class="pc__card"><img id="pcc-pcImg" alt="Your Cat Town postcard"><p id="pcc-pcHint">Your Cat Town postcard. Long-press it (phone) or right-click it (computer) to save.</p><div class="pc__row"><button id="pcc-pcClose" type="button">Close</button></div></div></div>
<div hidden><div id="pcc-title"></div><div id="pcc-cmList"></div><div id="pcc-crown"></div><div id="pcc-tags"></div><div id="pcc-sub"></div><div id="pcc-end"></div><div id="pcc-cm"></div><div id="pcc-brand"></div><div id="pcc-count"></div></div>
</section>
<script>window.CITY_LIVE = {{ page.metafields.cattown.town.value | json }};</script>
<script>window.CAT_VIEWER = true; window.CAT_LITE = matchMedia('(pointer: coarse)').matches || innerWidth < 820; window.CITY = {"live": {"followers": 0}, "pad": false, "shopCards": false, "day": 1, "followersBefore": 0, "followersNew": 1000, "order": "index", "newFrom": 0, "newTo": 100, "noReserved": true, "dayRange": [1, 40], "landmarks": [{"kind": "fishmarket", "sign": "Fish Supermarket", "at": 0, "note": "Top comment on Day 2, idea by PIKA"}, {"kind": "arcade", "sign": "Cat Arcade", "at": 0, "note": "Top comment on Day 3, idea by francisco12321"}], "counts": {"followers": 253, "likes": 467}};</script>
<script type="module" src="{{ 'pm2-cat-city.js' | asset_url }}"></script>

{% schema %}
{
  "name": "PETME2 Cat Town",
  "tag": "div",
  "class": "pm2-cat-town-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Card heading", "default": "Build the town with us" },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@petme2" },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" }
  ],
  "presets": [{ "name": "PETME2 Cat Town" }]
}
{% endschema %}
