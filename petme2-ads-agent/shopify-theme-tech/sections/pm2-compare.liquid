{%- comment -%} PETME2 comparison chart. One block = one model. Price/photo/link are live from the product. {%- endcomment -%}
{%- assign labels = section.settings.row1 | append: '|' | append: section.settings.row2 | append: '|' | append: section.settings.row3 | append: '|' | append: section.settings.row4 | append: '|' | append: section.settings.row5 | split: '|' -%}
<div class="color-{{ section.settings.color_scheme }} gradient pm2-cmp" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width">
    <div class="pm2-cmp__head">
      {%- if section.settings.eyebrow != blank -%}<p class="pm2-cmp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="pm2-cmp__sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="pm2-cmp__scroll">
      <table class="pm2-cmp__table">
        <thead><tr>
          <th scope="col" class="pm2-cmp__sticky"></th>
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            <th scope="col" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}<span class="pm2-cmp__badge">{{ block.settings.badge }}</span>{%- endif -%}
              {%- if p != blank and p.featured_image -%}<a href="{{ p.url }}" class="pm2-cmp__img">{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}</a>{%- endif -%}
              <a href="{{ p.url | default: '#' }}" class="pm2-cmp__name">{{ block.settings.name }}</a>
              {%- if p != blank -%}<span class="pm2-cmp__price">{{ p.price | money }}</span>{%- endif -%}
            </th>
          {%- endfor -%}
        </tr></thead>
        <tbody>
          {%- for label in labels -%}
            {%- if label == blank -%}{%- continue -%}{%- endif -%}
            {%- assign key = 'v' | append: forloop.index -%}
            <tr><th scope="row" class="pm2-cmp__sticky">{{ label }}</th>
              {%- for block in section.blocks -%}
                {%- assign v = block.settings[key] -%}
                <td>{%- if v == blank or v == '—' -%}<span class="pm2-cmp__no">—</span>{%- else -%}{{ v }}{%- endif -%}</td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
          <tr class="pm2-cmp__cta"><th class="pm2-cmp__sticky"></th>
            {%- for block in section.blocks -%}<td>{%- if block.settings.product != blank -%}<a class="button" href="{{ block.settings.product.url }}">{{ section.settings.button_text }}</a>{%- endif -%}</td>{%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
<style>
  .pm2-cmp { padding: 88px 0; scroll-margin-top: 100px; }
  .pm2-cmp__head { text-align: center; max-width: 680px; margin: 0 auto 44px; }
  .pm2-cmp__eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: 12px; color: rgb(var(--color-button)); margin: 0 0 12px; font-weight: 600; }
  .pm2-cmp__head h2 { margin: 0 0 14px; }
  .pm2-cmp__sub { color: rgba(var(--color-foreground), .7); margin: 0; }
  .pm2-cmp__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid rgba(var(--color-foreground), .1); border-radius: 16px; }
  .pm2-cmp__table { width: 100%; border-collapse: collapse; min-width: 660px; }
  .pm2-cmp__table th, .pm2-cmp__table td { padding: 16px 18px; text-align: center; border-bottom: 1px solid rgba(var(--color-foreground), .08); font-size: 1.4rem; vertical-align: middle; }
  .pm2-cmp__table tbody th { text-align: left; font-weight: 600; white-space: nowrap; color: rgba(var(--color-foreground), .75); }
  .pm2-cmp__sticky { position: sticky; left: 0; z-index: 1; background: rgb(var(--color-background)); }
  .pm2-cmp__table thead th { vertical-align: top; padding-top: 30px; position: relative; font-weight: 400; }
  .pm2-cmp__table thead th.pm2-cmp__sticky { position: sticky; }
  .pm2-cmp__img { display: block; aspect-ratio: 1; margin: 0 auto 14px; max-width: 150px; background: #fff; border-radius: 12px; overflow: hidden; }
  .pm2-cmp__img img { width: 100%; height: 100%; object-fit: contain; }
  .pm2-cmp__name { display: block; color: rgb(var(--color-foreground)); text-decoration: none; font-weight: 600; font-size: 1.6rem; }
  .pm2-cmp__price { display: block; margin-top: 4px; color: rgb(var(--color-button)); font-weight: 600; }
  .pm2-cmp__badge { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); font-size: 1.15rem; letter-spacing: .12em; text-transform: uppercase; padding: 3px 10px; border-radius: 99px; white-space: nowrap; font-weight: 600; }
  .pm2-cmp__no { opacity: .35; }
  .pm2-cmp__cta td, .pm2-cmp__cta th { border-bottom: 0; padding: 22px 12px 26px; }
  @media (max-width: 749px) { .pm2-cmp { padding: 56px 0; } .pm2-cmp__table th, .pm2-cmp__table td { padding: 12px 10px; font-size: 1.3rem; } }
</style>
{% schema %}
{
  "name": "PETME2 comparison",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "anchor", "label": "Anchor id (for #links)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare models" },
    { "type": "text", "id": "text", "label": "Sub text" },
    { "type": "text", "id": "row1", "label": "Row 1 label", "default": "Capacity" },
    { "type": "text", "id": "row2", "label": "Row 2 label" },
    { "type": "text", "id": "row3", "label": "Row 3 label" },
    { "type": "text", "id": "row4", "label": "Row 4 label" },
    { "type": "text", "id": "row5", "label": "Row 5 label" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "View details" }
  ],
  "blocks": [{ "type": "model", "name": "Model", "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "name", "label": "Short name" },
    { "type": "text", "id": "badge", "label": "Badge (optional)" },
    { "type": "text", "id": "v1", "label": "Row 1 value" },
    { "type": "text", "id": "v2", "label": "Row 2 value" },
    { "type": "text", "id": "v3", "label": "Row 3 value" },
    { "type": "text", "id": "v4", "label": "Row 4 value" },
    { "type": "text", "id": "v5", "label": "Row 5 value" }
  ] }],
  "max_blocks": 5,
  "presets": [{ "name": "PETME2 comparison" }]
}
{% endschema %}
