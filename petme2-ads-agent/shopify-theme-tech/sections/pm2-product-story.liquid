{%- comment -%}
  PETME2 product story: a scroll-driven story told with the product's OWN photos.
  Source: product metafield custom.story (multi-line text). One chapter per line:
    "<media position> :: <Title> :: <Short text>"   e.g. "3 :: Meals on your schedule :: Set meal times in the app."
  Media position is 1-based (1 = first product image). Lines with a missing image are skipped.
  Fallback when the metafield is empty: product images 2..7, alt text as the title.
  Desktop (>= 990px): sticky image that crossfades while text chapters scroll by, chapter numbers
  and a thin progress line. Mobile: one full-width image card per chapter, soft reveal.
  No layout shift (fixed aspect-ratio boxes), lazy images with srcset, reduced-motion safe.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign raw = product.metafields.custom.story.value | default: '' | strip
  assign max = s.max_chapters
  assign sizes_stage = '(min-width: 1200px) 560px, (min-width: 990px) 46vw, 1px'
  assign sizes_card = '(max-width: 989px) calc(100vw - 32px), 1px'

  # Build parallel lists (separator "|~|") of media index, title and text.
  assign sep = '|~|'
  assign idx_list = ''
  assign title_list = ''
  assign text_list = ''
  assign count = 0
  if raw != blank
    assign lines = raw | newline_to_br | split: '<br />'
    for line in lines
      if count >= max
        break
      endif
      assign line = line | strip
      if line == blank
        continue
      endif
      assign parts = line | split: '::'
      assign pos = parts[0] | strip | plus: 0
      assign i = pos | minus: 1
      if pos < 1 or product.media[i] == blank or product.media[i].preview_image == blank
        continue
      endif
      assign t = parts[1] | strip
      assign x = parts[2] | strip
      assign idx_list = idx_list | append: i | append: sep
      assign title_list = title_list | append: t | append: sep
      assign text_list = text_list | append: x | append: sep
      assign count = count | plus: 1
    endfor
  else
    for m in product.media offset: 1 limit: 6
      if count >= max
        break
      endif
      if m.preview_image == blank
        continue
      endif
      assign i = forloop.index
      # Generic SEO alts ("... – detail image 2 of 6") make poor titles: show the image only.
      assign t = m.alt | default: ' ' | strip
      if t contains 'detail image' or t contains 'main product photo'
        assign t = ' '
      endif
      assign idx_list = idx_list | append: i | append: sep
      assign title_list = title_list | append: t | append: sep
      assign text_list = text_list | append: ' ' | append: sep
      assign count = count | plus: 1
    endfor
  endif
  assign idxs = idx_list | split: sep
  assign titles = title_list | split: sep
  assign texts = text_list | split: sep
-%}

{%- if count > 0 -%}
<div
  class="color-{{ s.color_scheme }} gradient pm2-story"
  id="Pm2Story-{{ section.id }}"
  style="--pm2-pt: {{ s.padding_top }}px; --pm2-pb: {{ s.padding_bottom }}px;"
  data-pm2-story
>
  <div class="page-width">
    <header class="pm2-story__head">
      {%- if s.eyebrow != blank -%}<p class="pm2-story__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="pm2-story__title">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="pm2-story__sub">{{ s.subheading | escape }}</p>{%- endif -%}
    </header>

    <div class="pm2-story__grid">
      {%- comment -%} Desktop: sticky stage with every chapter image stacked {%- endcomment -%}
      <div class="pm2-story__stage" aria-hidden="true">
        <div class="pm2-story__frame">
          {%- for n in idxs -%}
            {%- assign i = n | plus: 0 -%}
            {%- assign img = product.media[i].preview_image -%}
            <div class="pm2-story__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
              {{ img | image_url: width: 1200 | image_tag:
                widths: '480, 640, 800, 1000, 1200',
                sizes: sizes_stage,
                loading: 'lazy',
                alt: '',
                class: 'pm2-story__img'
              }}
            </div>
          {%- endfor -%}
          <span class="pm2-story__counter"><b data-counter>01</b> / {{ count | prepend: '0' | slice: -2, 2 }}</span>
        </div>
      </div>

      <div class="pm2-story__track" style="--pm2-progress: 0;">
      <span class="pm2-story__rail" aria-hidden="true"><span class="pm2-story__fill"></span></span>
      <ol class="pm2-story__chapters" role="list">
        {%- for n in idxs -%}
          {%- assign i = n | plus: 0 -%}
          {%- assign k = forloop.index0 -%}
          {%- assign img = product.media[i].preview_image -%}
          {%- assign t = titles[k] | strip -%}
          {%- assign x = texts[k] | strip -%}
          {%- assign alt_text = img.alt | default: t -%}
          <li class="pm2-story__ch{% if forloop.first %} is-active{% endif %}" data-chapter="{{ k }}">
            <figure class="pm2-story__card">
              {{ img | image_url: width: 1000 | image_tag:
                widths: '360, 480, 640, 800, 1000',
                sizes: sizes_card,
                loading: 'lazy',
                alt: alt_text,
                class: 'pm2-story__img'
              }}
            </figure>
            <div class="pm2-story__copy">
              <span class="pm2-story__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- if t != blank -%}<h3 class="pm2-story__ch-title">{{ t | escape }}</h3>{%- endif -%}
              {%- if x != blank -%}<p class="pm2-story__ch-text">{{ x | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
      </div>
    </div>

    {%- if s.show_cta -%}
      <div class="pm2-story__end">
        {%- if s.cta_note != blank -%}<p class="pm2-story__end-note">{{ s.cta_note | escape }}</p>{%- endif -%}
        <a href="#MainContent" class="button pm2-story__cta" data-pm2-story-cta>
          {{- s.cta_label | default: 'Add to cart' | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
{%- elsif request.design_mode -%}
  <div class="page-width pm2-story__empty">
    PETME2 product story: this product has no images after the first one. Add images, or chapters in the product metafield <code>custom.story</code> ("image number :: Title :: Short text", one per line).
  </div>
{%- endif -%}

<style>
  .pm2-story { padding: var(--pm2-pt, 40px) 0 var(--pm2-pb, 40px); overflow-x: clip; }
  .pm2-story__head { max-width: 640px; margin: 0 auto 28px; text-align: center; }
  .pm2-story__eyebrow { margin: 0 0 8px; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(var(--color-foreground), .6); }
  .pm2-story__title { margin: 0; font-size: clamp(28px, 4vw, 44px); line-height: 1.1; letter-spacing: -.02em; }
  .pm2-story__sub { margin: 10px 0 0; font-size: 16px; line-height: 1.5; color: rgba(var(--color-foreground), .7); }

  .pm2-story__track { position: relative; }
  .pm2-story__chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .pm2-story__card { margin: 0 0 14px; aspect-ratio: 1 / 1; border-radius: 24px; overflow: hidden; background: rgba(var(--color-foreground), .04); }
  .pm2-story__img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .pm2-story__copy { padding: 0 4px; }
  .pm2-story__num { display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 26px; padding: 0 10px; border-radius: 999px; font-size: 13px; font-weight: 800; letter-spacing: .04em; background: rgba(var(--color-button), .1); color: rgb(var(--color-button)); }
  .pm2-story__ch-title { margin: 10px 0 6px; font-size: clamp(21px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -.01em; }
  .pm2-story__ch-text { margin: 0; max-width: 46ch; font-size: 16px; line-height: 1.55; color: rgba(var(--color-foreground), .72); }
  .pm2-story__stage, .pm2-story__rail { display: none; }

  .pm2-story__end { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 36px; text-align: center; }
  .pm2-story__end-note { margin: 0; font-size: 15px; color: rgba(var(--color-foreground), .7); }
  .pm2-story__cta { min-height: 48px; min-width: 200px; border-radius: 999px; font-weight: 800; }
  .pm2-story__empty { margin: 16px auto; padding: 14px 18px; border: 1px dashed rgba(var(--color-foreground), .3); border-radius: 16px; font-size: 13px; }

  /* Mobile: soft reveal of each card (only when JS is running) */
  .pm2-story.is-js .pm2-story__ch { transition: opacity .6s ease, transform .6s cubic-bezier(.2,.7,.2,1); }
  @media (max-width: 989px) {
    .pm2-story.is-js .pm2-story__ch:not(.is-seen) { opacity: 0; transform: translateY(24px); }
  }

  @media (min-width: 990px) {
    .pm2-story__head { margin-bottom: 40px; }
    .pm2-story__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
    .pm2-story__stage { display: block; position: sticky; top: max(96px, calc(50vh - 290px)); }
    .pm2-story__frame { position: relative; aspect-ratio: 1 / 1; max-height: 580px; margin: 0 auto; border-radius: 24px; overflow: hidden; background: rgba(var(--color-foreground), .04); }
    .pm2-story__slide { position: absolute; inset: 0; opacity: 0; transform: scale(1.02); transition: opacity .7s ease, transform 1.1s cubic-bezier(.2,.7,.2,1); }
    .pm2-story__slide.is-active { opacity: 1; transform: none; }
    .pm2-story__counter { position: absolute; left: 16px; bottom: 16px; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; background: rgba(var(--color-background), .9); color: rgba(var(--color-foreground), .7); box-shadow: 0 4px 14px rgba(0,0,0,.06); }
    .pm2-story__counter b { color: rgb(var(--color-foreground)); }
    .pm2-story__card { display: none; }
    .pm2-story__track { padding-left: 36px; }
    .pm2-story__chapters { gap: 0; }
    .pm2-story__rail { display: block; position: absolute; left: 0; top: 12vh; bottom: 12vh; width: 2px; border-radius: 2px; background: rgba(var(--color-foreground), .1); }
    .pm2-story__fill { position: absolute; inset: 0; border-radius: 2px; background: rgb(var(--color-button)); transform-origin: top; transform: scaleY(var(--pm2-progress, 0)); transition: transform .2s linear; }
    .pm2-story__ch { min-height: 56vh; display: flex; align-items: center; opacity: .28; transition: opacity .5s ease; }
    .pm2-story__ch:first-of-type { min-height: 48vh; }
    .pm2-story__ch:last-of-type { min-height: 56vh; }
    .pm2-story__ch.is-active { opacity: 1; }
    .pm2-story__ch-title { font-size: clamp(28px, 2.6vw, 36px); }
    .pm2-story__ch-text { font-size: 18px; }
    .pm2-story__end { margin-top: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm2-story__slide, .pm2-story__ch, .pm2-story__fill { transition: none !important; transform: none !important; }
    .pm2-story.is-js .pm2-story__ch:not(.is-seen) { opacity: 1; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('Pm2Story-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var chapters = Array.prototype.slice.call(root.querySelectorAll('[data-chapter]'));
    var slides = root.querySelectorAll('[data-slide]');
    var list = root.querySelector('.pm2-story__track');
    var counter = root.querySelector('[data-counter]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0;

    function setActive(n) {
      if (n === current) return;
      current = n;
      chapters.forEach(function (c, i) { c.classList.toggle('is-active', i === n); });
      Array.prototype.forEach.call(slides, function (s, i) {
        s.classList.toggle('is-active', i === n);
        if (i === n || i === n + 1) { var im = s.querySelector('img'); if (im) im.loading = 'eager'; }
      });
      if (counter) counter.textContent = (n + 1 < 10 ? '0' : '') + (n + 1);
    }

    if ('IntersectionObserver' in window) {
      root.classList.add('is-js');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-seen');
          setActive(Number(e.target.getAttribute('data-chapter')));
        });
      }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
      var reveal = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-seen'); reveal.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -12% 0px' });
      chapters.forEach(function (c) { io.observe(c); reveal.observe(c); });
    }

    /* Thin progress line (desktop only, rAF-throttled) */
    var ticking = false;
    function progress() {
      ticking = false;
      if (!list || window.innerWidth < 990) return;
      var r = list.getBoundingClientRect();
      var mid = window.innerHeight / 2;
      var p = Math.min(1, Math.max(0, (mid - r.top) / Math.max(1, r.height)));
      list.style.setProperty('--pm2-progress', p.toFixed(3));
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; window.requestAnimationFrame(progress); }
    }, { passive: true });
    progress();

    /* End CTA: use Dawn's own Add to cart button so variants, quantity and cart drawer all work */
    var cta = root.querySelector('[data-pm2-story-cta]');
    if (cta) cta.addEventListener('click', function (ev) {
      var btn = document.querySelector('product-form .product-form__submit[name="add"]')
        || document.querySelector('form[action*="/cart/add"] [type="submit"][name="add"]');
      if (!btn) return;
      ev.preventDefault();
      var info = btn.closest('product-info, .product') || btn;
      info.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      if (!btn.disabled && btn.getAttribute('aria-disabled') !== 'true') {
        window.setTimeout(function () { btn.click(); }, reduce ? 0 : 450);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "PETME2 product story",
  "tag": "section",
  "class": "pm2-story-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Chapters come from the product metafield custom.story. One per line: image number :: Title :: Short text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it in action" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What it does for you" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Scroll through the photos. One idea at a time." },
    { "type": "range", "id": "max_chapters", "label": "Maximum chapters", "min": 2, "max": 8, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_cta", "label": "Show Add to cart button at the end", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "cta_note", "label": "Text above the button", "default": "Free U.S. shipping. 30-day money-back guarantee." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "PETME2 product story" }]
}
{% endschema %}
