        "glass_opacity": 80,
        "enable_buttons": true,
        "enable_cards": true,
        "enable_image_zoom": true,
        "enable_typography": true,
        "enable_eyebrow": true,
        "enable_focus": true,
        "enable_selection": true,
        "enable_smooth_scroll": true
      }
