      "type": "announcement-bar",
      "settings": {
        "color_scheme": "scheme-5",
        "show_line_separator": false,
        "show_social": false,
        "auto_rotate": true,
        "change_slides_speed": 5,
        "enable_country_selector": false,
        "enable_language_selector": false
      },
      "blocks": {
        "a1": {
          "type": "announcement",
          "settings": {
            "text": "Free U.S. shipping on every order",
            "link": ""
          }
        },
        "a2": {
          "type": "announcement",
          "settings": {
            "text": "30-day money-back guarantee",
            "link": ""
          }
        },
        "a3": {
          "type": "announcement",
          "settings": {
            "text": "10% off your first order when you join our emails",
            "link": ""
          }
        }
      },
      "block_order": [
        "a1",
        "a2",
        "a3"
      ]
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-3",
        "menu_color_scheme": "scheme-3",
        "logo_position": "middle-left",
        "menu": "main-menu",
