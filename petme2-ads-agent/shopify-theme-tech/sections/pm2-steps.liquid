{%- comment -%}
  PETME2 "How it works": numbered glowing nodes joined by a gradient line.
  Horizontal on desktop, vertical on phone. Optional image beside the steps on desktop.
  CSS below contains no Liquid on purpose (per-instance values go through inline CSS vars).
{%- endcomment -%}
{%- liquid
  assign anim = ''
  if settings.animations_reveal_on_scroll
    assign anim = ' scroll-trigger animate--slide-in'
  endif
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<div
  class="color-{{ section.settings.color_scheme }} gradient pm2-steps{% if has_image %} pm2-steps--media{% endif %}"
  style="--pm2-pt: {{ section.settings.padding_top }}px; --pm2-pb: {{ section.settings.padding_bottom }}px; --pm2-count: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="page-width pm2-steps__layout">
    <div class="pm2-steps__main">
      <div class="pm2-steps__head{{ anim }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pm2-steps__eyebrow"><span class="pm2-steps__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pm2-steps__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <ol class="pm2-steps__list" role="list">
        {%- for block in section.blocks -%}
          <li class="pm2-steps__step{{ anim }}" data-cascade style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
            <span class="pm2-steps__node" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="pm2-steps__card">
              <span class="pm2-steps__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  {%- case block.settings.icon -%}
                    {%- when 'wifi' -%}<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><path d="M12 20h.01"/>
                    {%- when 'camera' -%}<path d="m16 13 5.2 3.5a.5.5 0 0 0 .8-.4V7.9a.5.5 0 0 0-.8-.4L16 11"/><rect x="2" y="6" width="14" height="12" rx="3"/>
                    {%- when 'bowl' -%}<path d="M3 11h18"/><path d="M4 11a8 8 0 0 0 16 0"/><path d="M8 20h8"/><path d="M9 4c0 1.5 1 1.5 1 3M14 4c0 1.5 1 1.5 1 3"/>
                    {%- when 'drop' -%}<path d="M12 2.7s-6 6.6-6 11.3a6 6 0 0 0 12 0c0-4.7-6-11.3-6-11.3z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>
                    {%- when 'filter' -%}<path d="m12 2 10 5-10 5L2 7l10-5z"/><path d="m2 12 10 5 10-5"/><path d="m2 17 10 5 10-5"/>
                    {%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
                    {%- when 'truck' -%}<path d="M2 5h12v11H2z"/><path d="M14 9h4l3 3.5V16h-7"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/>
                    {%- when 'phone' -%}<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/>
                    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                    {%- when 'mic' -%}<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v4"/>
                    {%- else -%}<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 3v4M17 5h4"/>
                  {%- endcase -%}
                </svg>
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="pm2-steps__title"><span class="visually-hidden">Step {{ forloop.index }}: </span>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="pm2-steps__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>

    {%- if has_image -%}
      <div class="pm2-steps__media{{ anim }}">
        <span class="pm2-steps__halo" aria-hidden="true"></span>
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 480px, 100vw',
            widths: '375, 550, 750, 1000, 1200',
            class: 'pm2-steps__img',
            alt: section.settings.image.alt
        }}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .pm2-steps { position: relative; overflow: hidden; padding-top: clamp(36px, calc(var(--pm2-pt, 96px) * .55), 64px); padding-bottom: clamp(36px, calc(var(--pm2-pb, 96px) * .55), 64px); --pm2-node: 44px; --pm2-gap: 16px; }
  @media (min-width: 750px) { .pm2-steps { padding-top: var(--pm2-pt, 96px); padding-bottom: var(--pm2-pb, 96px); --pm2-node: 52px; } }

  .pm2-steps__layout { display: grid; gap: 48px; align-items: center; }
  .pm2-steps__main { min-width: 0; }
  @media (min-width: 990px) { .pm2-steps--media .pm2-steps__layout { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 56px; } }

  .pm2-steps__head { margin-bottom: 28px; max-width: 720px; }
  @media (min-width: 750px) { .pm2-steps__head { margin-bottom: 52px; } }
  .pm2-steps:not(.pm2-steps--media) .pm2-steps__head { margin-left: auto; margin-right: auto; text-align: center; }
  .pm2-steps__eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 14px; padding: 6px 14px 6px 10px; border-radius: 999px;
    border: 1px solid rgba(var(--color-foreground), .08); background: rgba(var(--color-foreground), .04);
    font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(var(--color-foreground), .78); }
  .pm2-steps__dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: rgb(var(--color-button)); box-shadow: 0 0 0 4px rgba(var(--color-button), .16); }
  .pm2-steps__heading { margin: 0; font-family: var(--font-heading-family); font-weight: 700; font-size: clamp(28px, 4.6vw, 56px); line-height: 1.1; letter-spacing: -.03em; color: rgb(var(--color-foreground)); text-wrap: balance; }

  .pm2-steps__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--pm2-gap); }
  .pm2-steps__step { position: relative; display: grid; grid-template-rows: auto; grid-template-columns: var(--pm2-node) minmax(0, 1fr); gap: 14px; align-items: start; }

  /* connector line: vertical on phone */
  .pm2-steps__step:not(:last-child)::before { content: ""; position: absolute; left: calc(var(--pm2-node) / 2 - 1px); top: calc(var(--pm2-node) + 6px);
    bottom: calc(-1 * var(--pm2-gap) - 6px); width: 2px; border-radius: 2px;
    background: linear-gradient(180deg, rgba(var(--color-button), .55), rgba(var(--color-button), .12)); }

  @media (min-width: 750px) {
    .pm2-steps { --pm2-gap: 28px; }
    .pm2-steps__list { grid-template-columns: repeat(var(--pm2-count), minmax(0, 1fr)); }
    .pm2-steps__step { grid-template-columns: 1fr; grid-template-rows: auto 1fr; gap: 20px; }
    .pm2-steps__step:not(:last-child)::before { top: calc(var(--pm2-node) / 2 - 1px); left: calc(var(--pm2-node) + 12px); right: calc(-1 * var(--pm2-gap) + 12px);
      bottom: auto; width: auto; height: 2px;
      background: linear-gradient(90deg, rgba(var(--color-button), .55), rgba(var(--color-button), .12)); }
  }

  .pm2-steps__node { position: relative; z-index: 1; display: grid; place-items: center; width: var(--pm2-node); height: var(--pm2-node); border-radius: 50%;
    font-family: var(--font-heading-family); font-weight: 700; font-size: 16px; letter-spacing: -.01em;
    color: rgb(var(--color-button-text)); background: rgb(var(--color-button));
    box-shadow: 0 0 0 5px rgba(var(--color-button), .12), 0 8px 18px -8px rgba(var(--color-button), .7); }
  .pm2-steps__node::after { content: ""; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid rgba(var(--color-button), .35); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .pm2-steps__node::after { animation: pm2-steps-pulse 4s ease-out infinite; }
    .pm2-steps__step:nth-child(2) .pm2-steps__node::after { animation-delay: .7s; }
    .pm2-steps__step:nth-child(3) .pm2-steps__node::after { animation-delay: 1.4s; }
    .pm2-steps__step:nth-child(4) .pm2-steps__node::after { animation-delay: 2.1s; }
  }
  @keyframes pm2-steps-pulse { 0% { transform: scale(1); opacity: .7; } 60%, 100% { transform: scale(1.35); opacity: 0; } }

  .pm2-steps__card { min-width: 0; padding: 18px 18px 20px; border-radius: 20px; background: rgba(var(--color-foreground), .035); border: 1px solid rgba(var(--color-foreground), .07);
    transition: transform .45s cubic-bezier(.2, .7, .2, 1), border-color .45s ease, box-shadow .45s ease; }
  @media (hover: hover) {
    .pm2-steps__step:hover .pm2-steps__card { transform: translateY(-3px); border-color: rgba(var(--color-button), .3); box-shadow: 0 20px 44px -30px rgba(var(--color-shadow, 0, 0, 0), .35); }
  }
  @media (min-width: 750px) { .pm2-steps__card { padding: 26px; height: 100%; border-radius: 24px; } }
  .pm2-steps__icon { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; margin-bottom: 12px;
    color: rgb(var(--color-button)); background: rgba(var(--color-button), .1); }
  @media (min-width: 750px) { .pm2-steps__icon { width: 44px; height: 44px; border-radius: 14px; margin-bottom: 18px; } }
  .pm2-steps__title { margin: 0; font-family: var(--font-heading-family); font-weight: 650; font-size: 19px; line-height: 1.3; letter-spacing: -.015em; color: rgb(var(--color-foreground)); }
  @media (min-width: 750px) { .pm2-steps__title { font-size: 20px; } }
  .pm2-steps__text { margin: 6px 0 0; font-size: 16px; line-height: 1.55; color: rgba(var(--color-foreground), .7); }

  .pm2-steps__media { position: relative; display: none; }
  @media (min-width: 990px) { .pm2-steps__media { display: block; } }
  .pm2-steps__halo { display: block; position: absolute; inset: 8% 4%; z-index: 0; border-radius: 50%; background: radial-gradient(circle, rgba(var(--color-button), .2), transparent 65%); filter: blur(30px); }
  .pm2-steps__img { position: relative; z-index: 1; display: block; width: 100%; height: auto; border-radius: 24px; aspect-ratio: 3 / 4; object-fit: cover;
    border: 1px solid rgba(var(--color-foreground), .07); box-shadow: 0 30px 60px -40px rgba(var(--color-shadow, 0, 0, 0), .45); }

  @media (prefers-reduced-motion: reduce) {
    .pm2-steps__node::after { animation: none; opacity: 0; }
    .pm2-steps__card { transition: none; }
    .pm2-steps__step:hover .pm2-steps__card { transform: none; }
  }
</style>

{% schema %}
{
  "name": "PETME2 how it works",
  "tag": "section",
  "class": "section pm2-steps-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set it up once. Feed on time, every time." },
    { "type": "image_picker", "id": "image", "label": "Image (desktop only)", "info": "Shown beside the steps on desktop. Hidden on phones." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "bowl", "options": [
          { "value": "wifi", "label": "WiFi" }, { "value": "camera", "label": "Camera" }, { "value": "bowl", "label": "Bowl" },
          { "value": "drop", "label": "Water drop" }, { "value": "filter", "label": "Filter layers" }, { "value": "shield", "label": "Shield" },
          { "value": "truck", "label": "Truck" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "phone", "label": "Phone" },
          { "value": "clock", "label": "Clock" }, { "value": "mic", "label": "Microphone" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Fill the container" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Add dry food to the sealed container." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "PETME2 how it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "bowl", "title": "Fill the container", "text": "Add dry food to the sealed container." } },
        { "type": "step", "settings": { "icon": "wifi", "title": "Connect the app", "text": "Pair the feeder over WiFi." } },
        { "type": "step", "settings": { "icon": "clock", "title": "Set the schedule", "text": "Pick meal times and portions." } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
