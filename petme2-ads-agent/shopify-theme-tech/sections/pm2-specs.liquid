{%- comment -%} PETME2 tech spec strip: big numbers + short labels. {%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient pm2-specs">
  <div class="page-width pm2-specs__grid">
    {%- for block in section.blocks -%}
      <div class="pm2-specs__item" {{ block.shopify_attributes }}>
        <span class="pm2-specs__big">{{ block.settings.big }}</span>
        <span class="pm2-specs__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>
<style>
  .pm2-specs { padding: 44px 0; border-top: 1px solid rgba(var(--color-foreground), .08); border-bottom: 1px solid rgba(var(--color-foreground), .08); }
  .pm2-specs__grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); gap: 24px; }
  .pm2-specs__item { display: flex; flex-direction: column; gap: 6px; padding-left: 18px; border-left: 2px solid rgb(var(--color-button)); }
  .pm2-specs__big { font-family: var(--font-heading-family); font-weight: 700; font-size: clamp(28px, 3.2vw, 44px); line-height: 1; letter-spacing: -.02em; color: rgb(var(--color-foreground)); }
  .pm2-specs__label { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: rgba(var(--color-foreground), .65); }
  @media (max-width: 749px) { .pm2-specs__grid { grid-template-columns: repeat(2, 1fr); row-gap: 28px; } }
</style>
{% schema %}
{
  "name": "PETME2 spec strip",
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }],
  "blocks": [{ "type": "spec", "name": "Spec", "settings": [
    { "type": "text", "id": "big", "label": "Big text", "default": "1080P" },
    { "type": "text", "id": "label", "label": "Label", "default": "HD camera" }
  ] }],
  "max_blocks": 5,
  "presets": [{ "name": "PETME2 spec strip" }]
}
{% endschema %}
