{%- comment -%}
  PETME2 global style: friendly-minimal, mobile first. Place in the header group. Renders no visible
  markup: only CSS + a tiny scroll script that toggles html.pm2-scrolled. Every rule targets Dawn 15
  classes (.section-header, .header-wrapper, .header__icon, .announcement-bar__message, .button,
  .card-wrapper, .card--card, .card__inner, .card__media .media, .accordion summary,
  .rich-text__caption, .image-with-text__text--caption) and avoids layout properties on Dawn elements
  (no display/position/grid changes), so nothing can break the theme's own layout.
  Brand colours: blue #3366E6 (51,102,230), ink #1B2540 (27,37,64).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<style>
  /* PETME2 global style */
  .pm2-global-style-section { display: none; }

  {%- if s.enable_typography %}
  /* Readable, friendly type: 16px body on phones, soft rounded headings */
  body {
    font-size: 1.6rem;
    letter-spacing: 0.01em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  @media screen and (min-width: 750px) {
    body { font-size: 1.7rem; }
  }
  h1, h2, .h0, .h1, .h2 {
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  h3, .h3, h4, .h4 {
    letter-spacing: -0.005em;
  }
  h1, h2, .h0, .h1, .h2, h3, .h3 {
    text-wrap: balance;
  }
  p, .rte {
    text-wrap: pretty;
  }
  {%- endif %}

  {%- if s.enable_glass_header %}
  /* Clean header: soft frosted glass once the page scrolls (a pseudo layer carries the blur, so
     Dawn's fixed/absolute children such as the menu drawer keep their containing block). */
  .section-header .header-wrapper {
    transition: background-color .25s ease, box-shadow .25s ease;
  }
  .pm2-scrolled .section-header.shopify-section-header-sticky:not(.shopify-section-header-hidden) .header-wrapper {
    {%- if s.glass_tint == 'light' %}
    --color-background: 255, 255, 255;
    --color-foreground: 27, 37, 64;
    --color-link: 27, 37, 64;
    {%- endif %}
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: 0 1px 0 rgba(27, 37, 64, .06), 0 8px 24px -18px rgba(27, 37, 64, .25);
  }
  .pm2-scrolled .section-header.shopify-section-header-sticky .header-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: rgba(var(--color-background), {{ s.glass_opacity | divided_by: 100.0 }});
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .pm2-scrolled .section-header.shopify-section-header-sticky .header-wrapper::before {
      background: rgb(var(--color-background));
    }
  }
  /* Header icons: calm, consistent 44px tap targets with a soft round hover */
  .header__icon {
    border-radius: 999px;
    transition: background-color .2s ease;
  }
  .header__icon:hover {
    background-color: rgba(var(--color-foreground), .05);
  }
  .header__icon:hover .icon {
    transform: none;
  }
  /* Announcement bar: friendly, readable, not shouty */
  .announcement-bar__message {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  {%- endif %}

  {%- if s.enable_buttons %}
  /* Pill buttons: comfy 48px tap height, bold label, gentle lift + soft brand glow on hover */
  .button,
  .shopify-challenge__button,
  .customer button {
    --buttons-radius: 999px;
    --buttons-radius-outset: 999px;
    min-height: 4.8rem;
    padding-left: 2.8rem;
    padding-right: 2.8rem;
    font-weight: 700;
    letter-spacing: .01em;
    transition: transform .2s cubic-bezier(.2, .7, .2, 1), box-shadow .25s ease, background-color .2s ease;
  }
  .button:not([disabled]):not(.button--secondary):not(.button--tertiary):hover,
  .shopify-challenge__button:hover,
  .customer button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -12px rgba(var(--color-button), .55);
  }
  .button--secondary:not([disabled]):hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -14px rgba(var(--color-foreground), .35);
  }
  .button:not([disabled]):active { transform: translateY(0) scale(.98); }
  /* Bigger, friendlier FAQ / accordion rows (>= 52px tap target) */
  .accordion summary {
    padding-top: 1.9rem;
    padding-bottom: 1.9rem;
  }
  .accordion__title {
    font-weight: 700;
  }
  {%- endif %}

  {%- if s.enable_cards %}
  /* Cards: soft, airy shadow on hover; Dawn's own hover lift (theme setting) keeps the transform */
  .card-wrapper .card--card,
  .card-wrapper .card--standard .card__inner {
    transition: transform .35s cubic-bezier(.2, .7, .2, 1), box-shadow .35s ease;
  }
  @media (hover: hover) {
    .card-wrapper:hover .card--card,
    .card-wrapper:hover .card--standard .card__inner {
      box-shadow: 0 18px 40px -24px rgba(27, 37, 64, .22), 0 2px 6px -2px rgba(27, 37, 64, .05);
    }
  }
  body:not(.animate--hover-vertical-lift):not(.animate--hover-3d-lift) .card-wrapper:hover .card--card,
  body:not(.animate--hover-vertical-lift):not(.animate--hover-3d-lift) .card-wrapper:hover .card--standard .card__inner {
    transform: translateY(-3px);
  }
  {%- endif %}

  {%- if s.enable_image_zoom %}
  /* Gentle card image zoom (single-image cards only; Dawn swaps the 2nd image itself) */
  .card-wrapper .card__media .media > img:only-child {
    transition: transform .7s cubic-bezier(.2, .7, .2, 1);
  }
  @media (hover: hover) {
    .card-wrapper:hover .card__media .media > img:only-child {
      transform: scale(1.03);
    }
  }
  {%- endif %}

  {%- if s.enable_eyebrow %}
  /* Section eyebrows (Dawn caption blocks): friendly blue, sentence-like spacing */
  .rich-text__caption.caption-with-letter-spacing,
  .image-with-text__text--caption.caption-with-letter-spacing {
    font-weight: 700;
    letter-spacing: .08em;
    color: rgb(51, 102, 230);
  }
  .color-scheme-1 .rich-text__caption.caption-with-letter-spacing,
  .color-scheme-1 .image-with-text__text--caption.caption-with-letter-spacing {
    color: rgb(169, 193, 255);
  }
  .color-scheme-2 .rich-text__caption.caption-with-letter-spacing,
  .color-scheme-2 .image-with-text__text--caption.caption-with-letter-spacing {
    color: rgba(var(--color-foreground), .9);
  }
  {%- endif %}

  {%- if s.enable_focus %}
  /* Clear, on-brand focus rings */
  html:root {
    --focused-base-outline: 0.2rem solid rgb(51, 102, 230);
    --focused-base-outline-offset: 0.3rem;
    --focused-base-box-shadow: 0 0 0 0.6rem rgba(51, 102, 230, .2);
  }
  .button:focus-visible,
  .shopify-payment-button__button--unbranded:focus-visible {
    box-shadow: 0 0 0 0.3rem rgb(var(--color-background)), 0 0 0 0.55rem rgb(51, 102, 230);
  }
  {%- endif %}

  {%- if s.enable_selection %}
  ::selection {
    background-color: rgba(51, 102, 230, .22);
  }
  html {
    -webkit-tap-highlight-color: rgba(51, 102, 230, .12);
  }
  {%- endif %}

  {%- if s.enable_smooth_scroll %}
  html {
    scroll-padding-top: calc(var(--header-height, 0px) + 16px);
  }
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
  {%- endif %}

  /* Mobile safety net: never let a wide child cause sideways page scroll
     (overflow-x: clip does not create a scroll container, so the sticky header keeps working). */
  body { overflow-x: clip; }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .header__icon,
    .card-wrapper .card--card,
    .card-wrapper .card--standard .card__inner,
    .card-wrapper .card__media .media > img:only-child {
      transition: none !important;
    }
    .button:hover,
    .button:active,
    .card-wrapper:hover .card--card,
    .card-wrapper:hover .card__media .media > img:only-child {
      transform: none !important;
    }
  }
</style>
{%- if s.enable_glass_header -%}
  <script>
    (function () {
      var root = document.documentElement, ticking = false;
      function update() {
        root.classList.toggle('pm2-scrolled', (window.pageYOffset || root.scrollTop) > 8);
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
      }, { passive: true });
      update();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "PETME2 global style",
  "class": "pm2-global-style-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds the PETME2 friendly, minimal look to the whole store. Nothing visible is rendered by this section."
    },
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "enable_glass_header", "label": "Frosted sticky header, round icon hover, softer announcement bar", "default": true },
    {
      "type": "select",
      "id": "glass_tint",
      "label": "Glass tint",
      "options": [
        { "value": "scheme", "label": "Header color scheme" },
        { "value": "light", "label": "Light (white glass, dark text)" }
      ],
      "default": "light",
      "info": "Light only works well with a dark logo."
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Glass opacity",
      "min": 40,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    { "type": "header", "content": "Components" },
    { "type": "checkbox", "id": "enable_buttons", "label": "Pill buttons (48px) and roomy FAQ rows", "default": true },
    { "type": "checkbox", "id": "enable_cards", "label": "Soft card hover shadow", "default": true },
    { "type": "checkbox", "id": "enable_image_zoom", "label": "Gentle card image zoom on hover", "default": true },
    { "type": "header", "content": "Typography" },
    { "type": "checkbox", "id": "enable_typography", "label": "16px body on phones, friendly heading spacing", "default": true },
    { "type": "checkbox", "id": "enable_eyebrow", "label": "Blue caption (eyebrow) style", "default": true },
    { "type": "header", "content": "Details" },
    { "type": "checkbox", "id": "enable_focus", "label": "Blue focus rings", "default": true },
    { "type": "checkbox", "id": "enable_selection", "label": "Blue text selection and tap highlight", "default": true },
    { "type": "checkbox", "id": "enable_smooth_scroll", "label": "Smooth scroll for #anchor links", "default": true }
  ],
  "presets": [
    { "name": "PETME2 global style" }
  ]
}
{% endschema %}
