{%- comment -%}
  PETME2 full-width CTA band: soft accent wash (derived from the scheme button colour) + faint grid.
  Works on light (scheme-3/5) and dark (scheme-1) schemes. CSS below contains no Liquid on purpose.
{%- endcomment -%}
{%- liquid
  assign anim = ''
  if settings.animations_reveal_on_scroll
    assign anim = ' scroll-trigger animate--slide-in'
  endif
-%}
<div
  class="color-{{ section.settings.color_scheme }} gradient pm2-cta"
  style="--pm2-pt: {{ section.settings.padding_top }}px; --pm2-pb: {{ section.settings.padding_bottom }}px;"
>
  <span class="pm2-cta__mesh" aria-hidden="true"></span>
  <span class="pm2-cta__grid" aria-hidden="true"></span>
  <span class="pm2-cta__beam" aria-hidden="true"></span>
  <div class="page-width pm2-cta__inner{{ anim }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pm2-cta__eyebrow"><span class="pm2-cta__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pm2-cta__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="pm2-cta__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="pm2-cta__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="button button--primary pm2-cta__btn" {% if section.settings.button_link_1 != blank %}href="{{ section.settings.button_link_1 }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            {{- section.settings.button_label_1 | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="button button--secondary pm2-cta__btn pm2-cta__btn--ghost" {% if section.settings.button_link_2 != blank %}href="{{ section.settings.button_link_2 }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="pm2-cta__chips" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="pm2-cta__chip" {{ block.shopify_attributes }}>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{- block.settings.text | escape -}}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  .pm2-cta { position: relative; overflow: hidden; isolation: isolate; text-align: center;
    padding-top: clamp(44px, calc(var(--pm2-pt, 120px) * .5), 72px); padding-bottom: clamp(44px, calc(var(--pm2-pb, 120px) * .5), 72px); }
  @media (min-width: 750px) { .pm2-cta { padding-top: var(--pm2-pt, 120px); padding-bottom: var(--pm2-pb, 120px); } }

  /* soft accent wash derived from the scheme: airy on white, deep on navy */
  .pm2-cta__mesh { display: block; position: absolute; inset: 0; z-index: -3;
    background:
      radial-gradient(60% 80% at 12% 0%, rgba(var(--color-button), .2), transparent 62%),
      radial-gradient(50% 70% at 92% 100%, rgba(var(--color-button), .16), transparent 66%),
      linear-gradient(180deg, rgba(var(--color-button), .03), rgba(var(--color-button), .08)); }
  .pm2-cta__grid { display: block; position: absolute; inset: 0; z-index: -2; opacity: .8;
    background-image:
      linear-gradient(rgba(var(--color-foreground), .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--color-foreground), .035) 1px, transparent 1px);
    background-size: 56px 56px; background-position: center center;
    -webkit-mask-image: radial-gradient(60% 60% at 50% 50%, #000 10%, transparent 75%); mask-image: radial-gradient(60% 60% at 50% 50%, #000 10%, transparent 75%); }
  .pm2-cta__beam { display: block; position: absolute; z-index: -1; left: 50%; top: 50%; width: min(820px, 110vw); height: 360px; transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(var(--color-button), .18), transparent); filter: blur(40px); opacity: .8; }
  @media (prefers-reduced-motion: no-preference) {
    .pm2-cta__beam { animation: pm2-cta-breathe 12s ease-in-out infinite; }
  }
  @keyframes pm2-cta-breathe { 0%, 100% { opacity: .65; transform: translate(-50%, -50%) scale(1); } 50% { opacity: .9; transform: translate(-50%, -50%) scale(1.05); } }

  .pm2-cta__inner { position: relative; max-width: 900px; margin: 0 auto; }
  .pm2-cta__eyebrow { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; margin: 0 0 18px; padding: 6px 14px 6px 10px; border-radius: 999px;
    border: 1px solid rgba(var(--color-foreground), .1); background: rgba(var(--color-background), .7); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(var(--color-foreground), .82); }
  .pm2-cta__dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: rgb(var(--color-button)); box-shadow: 0 0 0 4px rgba(var(--color-button), .16); }
  .pm2-cta__heading { margin: 0; font-family: var(--font-heading-family); font-weight: 700; font-size: clamp(32px, 6.2vw, 76px); line-height: 1.06; letter-spacing: -.035em;
    color: rgb(var(--color-foreground)); text-wrap: balance; overflow-wrap: break-word; }
  .pm2-cta__text { margin: 16px auto 0; max-width: 600px; font-size: clamp(16px, 1.5vw, 20px); line-height: 1.6; color: rgba(var(--color-foreground), .74); text-wrap: pretty; }
  @media (min-width: 750px) { .pm2-cta__text { margin-top: 22px; } }
  .pm2-cta__text p { margin: 0; }

  .pm2-cta__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  @media (min-width: 750px) { .pm2-cta__buttons { margin-top: 36px; } }
  .pm2-cta .pm2-cta__btn { min-height: 52px; padding: 0 30px; font-size: 16px; font-weight: 600; letter-spacing: 0; border-radius: 999px; transition: transform .3s ease, box-shadow .3s ease; }
  .pm2-cta .pm2-cta__btn::before, .pm2-cta .pm2-cta__btn::after { border-radius: 999px; }
  .pm2-cta__btn.button--primary { box-shadow: 0 12px 28px -16px rgba(var(--color-button), .9); }
  @media (hover: hover) { .pm2-cta__btn:hover { transform: translateY(-2px); } }
  .pm2-cta__btn--ghost { background: rgba(var(--color-background), .7); }
  @media (max-width: 749px) { .pm2-cta__buttons { flex-direction: column; align-items: stretch; max-width: 440px; margin-left: auto; margin-right: auto; } }

  .pm2-cta__chips { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 28px 0 0; padding: 0; }
  @media (min-width: 750px) { .pm2-cta__chips { margin-top: 40px; gap: 10px; } }
  .pm2-cta__chip { display: inline-flex; align-items: center; gap: 7px; min-height: 34px; padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 500;
    color: rgba(var(--color-foreground), .85); background: rgba(var(--color-background), .7); border: 1px solid rgba(var(--color-foreground), .1);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .pm2-cta__chip svg { color: rgb(var(--color-button)); flex: none; }

  @media (prefers-reduced-motion: reduce) {
    .pm2-cta__beam { animation: none; }
    .pm2-cta__btn { transition: none; }
    .pm2-cta__btn:hover { transform: none; }
  }
</style>

{% schema %}
{
  "name": "PETME2 CTA band",
  "tag": "section",
  "class": "section pm2-cta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free U.S. shipping on orders $50+" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Smarter feeding starts today." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Automatic feeders and quiet fountains, controlled from your phone.</p>" },
    { "type": "text", "id": "button_label_1", "label": "First button label", "default": "Shop feeders" },
    { "type": "url", "id": "button_link_1", "label": "First button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label", "default": "Shop fountains" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "info": "The soft wash uses the scheme button colour. Works on light and dark schemes." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "text", "label": "Chip text", "default": "Free U.S. shipping $50+" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PETME2 CTA band",
      "blocks": [
        { "type": "chip", "settings": { "text": "Free U.S. shipping $50+" } },
        { "type": "chip", "settings": { "text": "WiFi app control" } },
        { "type": "chip", "settings": { "text": "Also on Amazon" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
