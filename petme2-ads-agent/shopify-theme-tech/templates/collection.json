{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-5"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 3,
        "columns_mobile": "2",
        "color_scheme": "scheme-3",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "standard",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "padding_top": 40,
        "padding_bottom": 64
      }
    },
    "compare": {
      "type": "rich-text",
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-4",
        "full_width": true,
        "padding_top": 56,
        "padding_bottom": 64
      },
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "NEED HELP CHOOSING?",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Compare models side by side",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>See capacity, bowls, camera and audio for every feeder, or capacity, material and filter for every fountain.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Compare feeders",
            "button_link": "/#compare-feeders",
            "button_style_secondary": false,
            "button_label_2": "Compare fountains",
            "button_link_2": "/#compare-fountains",
            "button_style_secondary_2": true
          }
        }
      },
      "block_order": [
        "caption",
        "heading",
        "text",
        "button"
      ]
    },
    "faq": {
      "type": "collapsible-content",
      "settings": {
        "caption": "FAQ",
        "heading": "Good to know",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "row",
        "container_color_scheme": "scheme-5",
        "color_scheme": "scheme-3",
        "open_first_collapsible_row": true,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 64,
        "padding_bottom": 72
      },
      "blocks": {
        "row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do the feeders work with wet food?",
            "icon": "serving_dish",
            "row_content": "<p>No. PETME2 feeders are made for dry food (kibble).</p>"
          }
        },
        "row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which feeder is best for 2 pets?",
            "icon": "paw_print",
            "row_content": "<p>The 3L Dual Bowl or the 5L Elevated WiFi. Both split food into two stainless steel bowls.</p>"
          }
        },
        "row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need WiFi?",
            "icon": "lightning_bolt",
            "row_content": "<p>WiFi is needed for the app: schedules, portions and alerts.</p>"
          }
        },
        "row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are the fountains loud?",
            "icon": "bottle",
            "row_content": "<p>No. Every PETME2 fountain uses a quiet pump made for use inside the home.</p>"
          }
        },
        "row_5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you offer free shipping?",
            "icon": "truck",
            "row_content": "<p>Yes. Shipping is free on U.S. orders of $50 or more.</p>"
          }
        }
      },
      "block_order": [
        "row_1",
        "row_2",
        "row_3",
        "row_4",
        "row_5"
      ]
    }
